@page
@model SWES.Pages.UnidadesConcedentes.CadastroModel

@{
    ViewData["Title"] = Model.UnidadeConcedente.Id.HasValue
        ? "Editar cadastro"
        : "Cadastrar unidade concedente";
}

<div class="instituicoes-page">
    <div class="instituicoes-header">
        <div>
            <h1>@(Model.UnidadeConcedente.Id.HasValue ? "Editar cadastro" : "Cadastrar unidade concedente")</h1>
            <p>Cadastre uma unidade concedente e informe se ela também é uma instituição de ensino.</p>
        </div>
        <a asp-page="/UnidadesConcedentes/Index" class="instituicoes-btn-secundario">Voltar</a>
    </div>

    <div class="instituicoes-form-card">
        <form method="post" asp-page-handler="Salvar">
            <input type="hidden" asp-for="UnidadeConcedente.Id" />

            <div asp-validation-summary="ModelOnly" class="instituicoes-validacao-resumo"></div>

            <div class="instituicoes-form-grid">
                <div class="instituicoes-form-campo">
                    <label asp-for="UnidadeConcedente.RazaoSocial">Razão social / Nome</label>
                    <input asp-for="UnidadeConcedente.RazaoSocial" class="instituicoes-form-input" maxlength="150" />
                    <span asp-validation-for="UnidadeConcedente.RazaoSocial"
                          class="instituicoes-validacao-campo"></span>
                </div>

                <div class="instituicoes-form-campo">
                    <label asp-for="UnidadeConcedente.Cnpj">CNPJ</label>
                    <input asp-for="UnidadeConcedente.Cnpj" id="cnpj-concedente" class="instituicoes-form-input"
                           maxlength="18" placeholder="00.000.000/0000-00" inputmode="numeric" />
                    <span asp-validation-for="UnidadeConcedente.Cnpj" class="instituicoes-validacao-campo"></span>
                </div>

                <div class="instituicoes-form-campo">
                    <label asp-for="UnidadeConcedente.Endereco">Endereço</label>
                    <input asp-for="UnidadeConcedente.Endereco" class="instituicoes-form-input" maxlength="200" />
                    <span asp-validation-for="UnidadeConcedente.Endereco" class="instituicoes-validacao-campo"></span>
                </div>

                <div class="instituicoes-form-campo">
                    <label asp-for="UnidadeConcedente.Telefone">Telefone</label>
                    <input asp-for="UnidadeConcedente.Telefone" class="instituicoes-form-input" maxlength="12" />
                    <span asp-validation-for="UnidadeConcedente.Telefone" class="instituicoes-validacao-campo"></span>
                </div>

                <div class="instituicoes-form-campo">
                    <label asp-for="UnidadeConcedente.Email">E-mail</label>
                    <input asp-for="UnidadeConcedente.Email" type="email" class="instituicoes-form-input"
                           maxlength="150" />
                    <span asp-validation-for="UnidadeConcedente.Email" class="instituicoes-validacao-campo"></span>
                </div>
            </div>

            @if (!Model.SomenteInstituicao)
            {
                <div class="instituicoes-form-campo">
                    <label>
                        <input asp-for="UnidadeConcedente.InstituicaoEnsino" />
                        É uma instituição
                    </label>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="UnidadeConcedente.InstituicaoEnsino" value="true" />
            }

            <div class="instituicoes-form-acoes">
                <a asp-page="/UnidadesConcedentes/Index" class="instituicoes-btn-secundario">Cancelar</a>
                <button type="submit" class="instituicoes-btn-primario">Salvar cadastro</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const campoCnpj = document.getElementById("cnpj-concedente");

        if (campoCnpj) {
            campoCnpj.addEventListener("input", function () {
                let valor = this.value.replace(/\D/g, "").substring(0, 14);

                if (valor.length > 12) {
                    valor = valor.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{0,2}).*/, "$1.$2.$3/$4-$5");
                } else if (valor.length > 8) {
                    valor = valor.replace(/^(\d{2})(\d{3})(\d{3})(\d{0,4}).*/, "$1.$2.$3/$4");
                } else if (valor.length > 5) {
                    valor = valor.replace(/^(\d{2})(\d{3})(\d{0,3}).*/, "$1.$2.$3");
                } else if (valor.length > 2) {
                    valor = valor.replace(/^(\d{2})(\d{0,3}).*/, "$1.$2");
                }

                this.value = valor;
            });
        }
    </script>
}
