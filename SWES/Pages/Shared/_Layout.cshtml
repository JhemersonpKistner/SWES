@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SWES</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SWES.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar" id="menuLateral">
            <button type="button" class="btn-fechar-menu" onclick="fecharMenu()" aria-label="Fechar menu">
                <i class="bi bi-x-lg"></i>
            </button>

            <div class="sidebar-header">
                <img src="~/images/logo.unidesc.webp" alt="Logo da UNIDESC" class="logo-faculdade" />
                <h2>SISTEMA DE ESTÁGIOS</h2>
            </div>

            <nav class="menu" aria-label="Menu principal">
                <a href="/" class="menu-item @(currentPage == "/Index" ? "menu-item-ativo" : "")">
                    <span><i class="bi bi-speedometer2"></i></span>
                    Dashboard
                </a>
                <a href="/Usuarios/Index"
                   class="menu-item @(currentPage?.StartsWith("/Usuarios") == true ? "menu-item-ativo" : "")">
                    <span><i class="bi bi-people"></i></span>
                    Usuários
                </a>
                <a href="#" 
                    class="menu-item">
                    <span><i class="bi bi-mortarboard"></i></span>
                    Alunos
                </a>
                <a href="#" class="menu-item">
                    <span><i class="bi bi-person-workspace"></i></span>
                    Professores
                </a>
                <a href="/UnidadesConcedentes" class="menu-item @(currentPage?.StartsWith("/InstituicoesEnsino") == true ? "menu-item-ativo" : "")">
                    <span><i class="bi bi-building"></i></span>
                    Concedentes
                </a>
                <a href="/InstituicoesEnsino/Index" class="menu-item @(currentPage?.StartsWith("/InstituicoesEnsino") == true ? "menu-item-ativo" : "")">
                    <span><i class="bi bi-bank"></i></span>
                    Instituições
                </a>
                <a href="#" class="menu-item">
                    <span><i class="bi bi-file-earmark-text"></i></span>
                    Documentos
                </a>
                <a href="#" class="menu-item">
                    <span><i class="bi bi-briefcase"></i></span>
                    Estágios
                </a>
                <a href="#" class="menu-item">
                    <span><i class="bi bi-star"></i></span>
                    Avaliações
                </a>
            <div class="menu-configuracoes">
                <button type="button"
                        class="menu-item menu-toggle @(currentPage?.StartsWith("/Configuracoes") == true || currentPage?.StartsWith("/Cursos") == true ? "menu-item-ativo" : "")"
                        id="btnConfiguracoes"
                        aria-expanded="@(currentPage?.StartsWith("/Configuracoes") == true || currentPage?.StartsWith("/Cursos") == true ? "true" : "false")"
                        aria-controls="submenuConfiguracoes" onclick="alternarSubmenu('submenuConfiguracoes', this)">
                    <span><i class="bi bi-gear"></i></span>
                    <span class="menu-item-texto">Configurações</span>
                    <i class="bi bi-chevron-down submenu-seta"></i>
                </button>

                <div class="submenu @(currentPage?.StartsWith("/Configuracoes") == true || currentPage?.StartsWith("/Cursos") == true ? "submenu-aberto" : "")"
                     id="submenuConfiguracoes">

                    <a href="/Cursos/Index"
                       class="submenu-item @(currentPage?.StartsWith("/Cursos") == true ? "submenu-item-ativo" : "")">
                        <i class="bi bi-mortarboard"></i>
                        Cursos
                    </a>
                </div>
            </div>

            </nav>

            


        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay" onclick="fecharMenu()"></div>

        <main class="app-content">
            <button type="button" class="btn-menu-mobile" onclick="abrirMenu()" aria-label="Abrir menu">
                <i class="bi bi-list"></i>
            </button>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>