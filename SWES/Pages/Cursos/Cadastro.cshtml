@page
@model SWES.Pages.Cursos.CadastroModel

@{
    ViewData["Title"] = Model.Dados.Id.HasValue ? "Editar curso" : "Novo curso";
    bool editando = Model.Dados.Id.HasValue;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">@(editando ? "Editar curso" : "Novo curso")</h1>
            <p class="text-muted mb-0">
                @(editando ? "Atualize as informações do curso." : "Preencha os dados para cadastrar um curso.")
            </p>
        </div>

        <a asp-page="./Index" class="btn btn-outline-secondary">
            Voltar para cursos
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Dados.Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Dados.Nome" class="form-label">Nome do curso</label>
                        <input asp-for="Dados.Nome" class="form-control" maxlength="100" placeholder="Ex.: Sistemas de Informação" />
                        <span asp-validation-for="Dados.Nome" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Dados.QuantidadeSemestres" class="form-label">Quantidade de semestres</label>
                        <input asp-for="Dados.QuantidadeSemestres" type="number" min="1" max="20" class="form-control" />
                        <span asp-validation-for="Dados.QuantidadeSemestres" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Dados.Periodo" class="form-label">Período</label>
                        <select asp-for="Dados.Periodo" class="form-select">
                            <option value="">Selecione o período</option>
                            <option value="Matutino">Matutino</option>
                            <option value="Vespertino">Vespertino</option>
                            <option value="Noturno">Noturno</option>
                            <option value="Integral">Integral</option>
                        </select>
                        <span asp-validation-for="Dados.Periodo" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Dados.InstituicaoId" class="form-label">Instituição de ensino</label>
                        <select asp-for="Dados.InstituicaoId" asp-items="Model.Instituicoes" class="form-select">
                            <option value="">Selecione a instituição de ensino</option>
                        </select>
                        <span asp-validation-for="Dados.InstituicaoId" class="text-danger"></span>

                        @if (Model.Instituicoes.Count == 0)
                        {
                            <div class="form-text text-warning">
                                Nenhuma instituição de ensino ativa foi encontrada. Cadastre ou ative uma instituição antes de continuar.
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" disabled="@(Model.Instituicoes.Count == 0)">
                        @(editando ? "Salvar alterações" : "Cadastrar curso")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}