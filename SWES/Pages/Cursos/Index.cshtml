@page
@model SWES.Pages.Cursos.IndexModel
@using System.Linq

@{
    ViewData["Title"] = "Cursos";
}

<div class="instituicoes-page cursos-page">
    <div class="instituicoes-header">
        <div>
            <span class="instituicoes-eyebrow">
                <i class="bi bi-mortarboard"></i>
                GESTÃO ACADÊMICA
            </span>
            <h1>Cursos</h1>
            <p>Gerencie os cursos e suas instituições de ensino.</p>
        </div>

        <a asp-page="./Cadastro" class="instituicoes-btn instituicoes-btn-primary">
            <i class="bi bi-plus-lg"></i>
            Cadastrar curso
        </a>
    </div>

    <div class="instituicoes-resumo">
        <div class="instituicoes-resumo-card">
            <div class="instituicoes-resumo-icone azul"><i class="bi bi-mortarboard"></i></div>
            <div><span>Total de cursos</span><strong>@Model.Cursos.Count</strong></div>
        </div>
        <div class="instituicoes-resumo-card">
            <div class="instituicoes-resumo-icone verde"><i class="bi bi-check-circle"></i></div>
            <div><span>Cursos ativos</span><strong>@Model.Cursos.Count(c => c.Ativo)</strong></div>
        </div>
        <div class="instituicoes-resumo-card">
            <div class="instituicoes-resumo-icone cinza"><i class="bi bi-person-workspace"></i></div>
            <div><span>Professores vinculados</span><strong>@Model.Cursos.Sum(c => c.QuantidadeProfessores)</strong></div>
        </div>
    </div>

    <section class="instituicoes-card">
        <div class="instituicoes-card-header">
            <div>
                <h2>Cursos cadastrados</h2>
                <p>Consulte os cursos, suas instituições e a situação dos registros.</p>
            </div>
            <span class="instituicoes-contador">@Model.Cursos.Count curso(s)</span>
        </div>

        <form method="get" class="instituicoes-filtros cursos-filtros">
            <div class="instituicoes-pesquisa">
                <label asp-for="Pesquisa">Pesquisar curso</label>
                <div class="instituicoes-input-wrapper">
                    <i class="bi bi-search"></i>
                    <input asp-for="Pesquisa" placeholder="Digite o nome do curso..." />
                </div>
            </div>

            <div class="cursos-filtro-situacao">
                <label asp-for="Situacao">Situação</label>
                <select asp-for="Situacao" class="cursos-select-filtro">
                    <option value="">Todos os cursos</option>
                    <option value="Ativo">Ativos</option>
                    <option value="Inativo">Inativos</option>
                </select>
            </div>

            <button type="submit" class="instituicoes-btn instituicoes-btn-primary">
                <i class="bi bi-search"></i> Filtrar
            </button>
            <a asp-page="./Index" class="instituicoes-btn instituicoes-btn-secondary">
                <i class="bi bi-arrow-counterclockwise"></i> Limpar
            </a>
        </form>

        @if (Model.Cursos.Count == 0)
        {
            <div class="instituicoes-vazio">
                <div class="instituicoes-vazio-icone"><i class="bi bi-mortarboard"></i></div>
                @if (!string.IsNullOrWhiteSpace(Model.Pesquisa) || !string.IsNullOrWhiteSpace(Model.Situacao))
                {
                    <h3>Nenhum curso encontrado</h3>
                    <p>Não encontramos cursos correspondentes aos filtros informados.</p>
                    <a asp-page="./Index" class="instituicoes-btn instituicoes-btn-secondary">Limpar filtros</a>
                }
                else
                {
                    <h3>Nenhum curso cadastrado</h3>
                    <p>Cadastre o primeiro curso para começar a gerenciar os vínculos acadêmicos.</p>
                    <a asp-page="./Cadastro" class="instituicoes-btn instituicoes-btn-primary"><i class="bi bi-plus-lg"></i> Cadastrar curso</a>
                }
            </div>
        }
        else
        {
            <div class="instituicoes-tabela-wrapper">
                <table class="instituicoes-tabela cursos-tabela">
                    <thead>
                        <tr>
                            <th>Curso</th>
                            <th>Instituição de ensino</th>
                            <th>Semestres</th>
                            <th>Período</th>
                            <th>Professores</th>
                            <th>Situação</th>
                            <th class="instituicoes-coluna-acoes">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var curso in Model.Cursos)
                        {
                            <tr>
                                <td>
                                    <div class="instituicoes-identificacao">
                                        <div class="instituicoes-avatar"><i class="bi bi-mortarboard"></i></div>
                                        <div class="instituicoes-nome">
                                            <strong>@curso.Nome</strong>
                                            <span>Curso de graduação</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@curso.InstituicaoNome</td>
                                <td><span class="cursos-dado-numero">@curso.QuantidadeSemestres</span></td>
                                <td><span class="cursos-periodo">@curso.Periodo</span></td>
                                <td><span class="cursos-dado-numero">@curso.QuantidadeProfessores</span></td>
                                <td>
                                    @if (curso.Ativo)
                                    {
                                        <span class="registro-status ativo"><span></span>Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="registro-status inativo"><span></span>Inativo</span>
                                    }
                                </td>
                                <td>
                                    <div class="registro-acoes">
                                        <a asp-page="./Cadastro" asp-route-id="@curso.Id"
                                           class="registro-acao editar" title="Editar curso" aria-label="Editar @curso.Nome">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-page-handler="AlterarSituacao"
                                              asp-route-id="@curso.Id" asp-route-ativar="@(!curso.Ativo)"
                                              onsubmit="return confirm('Deseja realmente @(curso.Ativo ? "inativar" : "ativar") este curso?');">
                                            <button type="submit"
                                                    class="registro-acao @(curso.Ativo ? "inativar" : "reativar")"
                                                    title="@(curso.Ativo ? "Inativar curso" : "Ativar curso")"
                                                    aria-label="@(curso.Ativo ? "Inativar curso " : "Ativar curso ")@curso.Nome">
                                                <i class="bi @(curso.Ativo ? "bi-pause-circle" : "bi-arrow-clockwise")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
