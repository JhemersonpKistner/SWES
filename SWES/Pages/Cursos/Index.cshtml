
@page
@model SWES.Pages.Cursos.IndexModel

<div class="container-fluid px-3 px-md-4 py-4">
    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Cursos</h1>
            <p class="text-secondary mb-0">
                Gerencie os cursos vinculados aos professores orientadores.
            </p>
        </div>

        <a asp-page="/Cursos/Cadastro"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>
            Cadastrar curso
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10
                                text-primary">
                        <i class="bi bi-mortarboard fs-4"></i>
                    </div>
                    <div>
                        <p class="text-secondary mb-1 small">
                            Total de cursos
                        </p>
                        <h3 class="fw-bold mb-0">
                            @Model.Cursos.Count
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10
                                text-success">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                    <div>
                        <p class="text-secondary mb-1 small">
                            Cursos ativos
                        </p>
                        <h3 class="fw-bold mb-0">
                            @Model.Cursos.Count(c => c.Ativo)
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-secondary bg-opacity-10
                                text-secondary">
                        <i class="bi bi-person-workspace fs-4"></i>
                    </div>
                    <div>
                        <p class="text-secondary mb-1 small">
                            Professores vinculados
                        </p>
                        <h3 class="fw-bold mb-0">
                            @Model.Cursos.Sum(c => c.QuantidadeProfessores)
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 mb-4">
                <div class="col-12 col-md-7 col-lg-8">
                    <label for="pesquisa" class="form-label">
                        Pesquisar curso
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input id="pesquisa"
                               name="Pesquisa"
                               value="@Model.Pesquisa"
                               class="form-control"
                               placeholder="Digite o nome do curso..." />
                    </div>
                </div>

                <div class="col-12 col-md-5 col-lg-4">
                    <label for="situacao" class="form-label">
                        Situação
                    </label>
                    <select id="situacao"
                            name="Situacao"
                            class="form-select">
                        <option value="">Todas as situações</option>
                        <option value="Ativo"
                                selected="@(Model.Situacao == "Ativo")">
                            Ativo
                        </option>
                        <option value="Inativo"
                                selected="@(Model.Situacao == "Inativo")">
                            Inativo
                        </option>
                    </select>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Pesquisar
                    </button>

                    <a asp-page="/Cursos/Index"
                       class="btn btn-outline-secondary">
                        Limpar filtros
                    </a>
                </div>
            </form>

            <div class="d-flex justify-content-between
                        align-items-center gap-2 mb-3">
                <h2 class="h5 fw-semibold mb-0">
                    Cursos cadastrados
                </h2>
                <span class="badge text-bg-light border">
                    @Model.Cursos.Count resultado(s)
                </span>
            </div>

            @if (Model.Cursos.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-x display-5
                              text-secondary"></i>
                    <h3 class="h5 mt-3">Nenhum curso encontrado</h3>
                    <p class="text-secondary mb-0">
                        Tente alterar os filtros ou cadastre um novo curso.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nome do curso</th>
                                <th>Professores vinculados</th>
                                <th>Situação</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var curso in Model.Cursos)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-2 p-2
                                                        bg-primary bg-opacity-10
                                                        text-primary">
                                                <i class="bi bi-book"></i>
                                            </div>
                                            <span class="fw-medium">
                                                @curso.Nome
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary">
                                            <i class="bi bi-people me-1"></i>
                                            @curso.QuantidadeProfessores
                                        </span>
                                    </td>
                                    <td>
                                        @if (curso.Ativo)
                                        {
                                            <span class="badge rounded-pill
                                                         text-bg-success">
                                                Ativo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill
                                                         text-bg-secondary">
                                                Inativo
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-end
                                                    gap-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary"
                                                    disabled
                                                    title="Aguardando integração com o backend">
                                                <i class="bi bi-pencil"></i>
                                                <span class="d-none d-lg-inline">
                                                    Editar
                                                </span>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    disabled
                                                    title="Aguardando integração com o backend">
                                                <i class="bi bi-arrow-repeat"></i>
                                                <span class="d-none d-lg-inline">
                                                    Situação
                                                </span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <p class="text-secondary small mt-3 mb-0">
        Ações de cadastro, edição e alteração de situação serão
        habilitadas após a integração com o backend.
    </p>
</div>
