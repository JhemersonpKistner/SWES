@page
@model SWES.Pages.LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img src="~/images/logo.unidesc.webp" alt="Logo da instituição" />
        </div>
        <span class="login-eyebrow">SWES · ESTÁGIO SUPERVISIONADO</span>
        <h1>Entrar no sistema</h1>
        <p class="text-muted">Acesse sua conta utilizando seu e-mail e senha.</p>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-mail</label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="username"
                       placeholder="seu@email.com" autofocus />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label">Senha</label>
                <input asp-for="Senha" type="password" class="form-control" autocomplete="current-password"
                       placeholder="Digite sua senha" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 login-submit">
                <i class="bi bi-box-arrow-in-right"></i>
                Entrar
            </button>
        </form>

        <a asp-page="/Index" class="login-voltar"><i class="bi bi-arrow-left"></i> Voltar à página inicial</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
