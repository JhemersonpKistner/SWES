@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page">


       <header class="dashboard-header">

    <h1>Dashboard</h1>

    <p>
        Visão geral do sistema de gerenciamento de estágios
    </p>

    <span class="admin-label">
        Administrador
    </span>

</header>

        <!-- CARDS -->
        <section class="cards">

            <div class="card">
                <h3>ALUNOS</h3>
                <strong>248</strong>
            </div>

            <div class="card">
                <h3>ESTÁGIOS</h3>
                <strong>86</strong>
            </div>

            <div class="card">
                <h3>DOCUMENTOS</h3>
                <strong>32</strong>
            </div>

            <div class="card">
                <h3>EMPRESAS</h3>
                <strong>54</strong>
            </div>

        </section>


        <!-- ÁREA DOS GRÁFICOS -->
        <section class="charts">

            <div class="chart-box">
                <h3>Estágios por Situação</h3>

                <div class="chart-container">
                    <canvas id="graficoSituacao"></canvas>
                </div>
            </div>


            <div class="chart-box">
                <h3>Estágios Cadastrados por mês</h3>

                <div class="chart-container">
                    <canvas id="graficoMensal"></canvas>
                </div>
            </div>


            <div class="chart-box">
                <h3>Estágios por tipo</h3>

                <div class="chart-container">
                    <canvas id="graficoTipo"></canvas>
                </div>
            </div>


            <!-- ATIVIDADES RECENTES -->
            <div class="activities">

                <h3>Atividades Recentes</h3>

                <div class="activity">
                    João Silva
                </div>

                <div class="activity">
                    Maria Souza
                </div>

                <div class="activity">
                    Pedro Santos
                </div>

            </div>

        </section>

</div>

@section Scripts {
    <script>
        // Os gráficos usam contêineres com altura responsiva e são
        // redimensionados automaticamente pelo Chart.js.
        const ctxSituacao = document.getElementById('graficoSituacao');
        const ctxMensal = document.getElementById('graficoMensal');
        const ctxTipo = document.getElementById('graficoTipo');

        if (ctxSituacao) {
            new Chart(ctxSituacao, {
                type: 'doughnut',
                data: {
                    labels: ['Em andamento', 'Concluídos', 'Cancelados'],
                    datasets: [{ data: [42, 35, 9] }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    resizeDelay: 100,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        if (ctxMensal) {
            new Chart(ctxMensal, {
                type: 'line',
                data: {
                    labels: ['Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set'],
                    datasets: [{
                        label: 'Estágios cadastrados',
                        data: [8, 12, 15, 10, 18, 23],
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    resizeDelay: 100,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        if (ctxTipo) {
            new Chart(ctxTipo, {
                type: 'bar',
                data: {
                    labels: ['Interno', 'Externo'],
                    datasets: [{ label: 'Quantidade', data: [34, 52] }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    resizeDelay: 100,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }
    </script>
}
