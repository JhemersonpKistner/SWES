            <a href="#" class="menu-item">
            <span><i class="bi bi-gear"></i></span>
            Configuração
        </a>
        </div>

    </aside>


    <!-- CONTEÚDO PRINCIPAL -->
    <main class="main-content">

        <header class="dashboard-header">
            <h1>Dashboard</h1>

            <p>
                Visão geral do sistema de gerenciamento de estágios
            </p>

            <span class="admin-label">
                Administrador
            </span>
        </header>


        <!-- CARDS -->
        <section class="cards">

            <div class="card">
                <h3>ALUNOS</h3>
                <strong>248</strong>
            </div>

            <div class="card">
                <h3>ESTÁGIOS</h3>
                <strong>86</strong>
            </div>

            <div class="card">
                <h3>DOCUMENTOS</h3>
                <strong>32</strong>
            </div>

            <div class="card">
                <h3>EMPRESAS</h3>
                <strong>54</strong>
            </div>

        </section>


        <!-- ÁREA DOS GRÁFICOS -->
        <section class="charts">

            <div class="chart-box">
                <h3>Estágios por Situação</h3>

                <div class="chart-placeholder">
                    Gráfico
                </div>
            </div>


            <div class="chart-box">
                <h3>Estágios Cadastrados por mês</h3>

                <div class="chart-placeholder">
                    Gráfico
                </div>
            </div>


            <div class="chart-box">
                <h3>Estágios por Status</h3>

                <div class="chart-placeholder">
                    Gráfico
                </div>
            </div>


            <!-- ATIVIDADES RECENTES -->
            <div class="activities">

                <h3>Atividades Recentes</h3>

                <div class="activity">
                    João Silva
                </div>

                <div class="activity">
                    Maria Souza
                </div>

                <div class="activity">
                    Pedro Santos
                </div>

            </div>

        </section>

