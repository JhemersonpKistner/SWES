@page
@model SWES.Pages.Usuarios.IndexModel


<div class="usuarios-container instituicoes-page">

    <div class="usuarios-header instituicoes-header">
        <div>
            <span class="instituicoes-eyebrow"><i class="bi bi-people"></i> GESTÃO DE ESTÁGIOS</span>
            <h1>Usuários</h1>
            <p class="usuarios-subtitulo">Gerencie os usuários cadastrados no sistema</p>
        </div>

        <div class="usuarios-botoes">
            <a asp-page="/Index" class="btn-voltar-dashboard">
                <i class="bi bi-arrow-left"></i>
                Voltar
            </a>

            <a asp-page="/Usuarios/Cadastro" class="btn-cadastrar instituicoes-btn instituicoes-btn-primary">
                <i class="bi bi-person-plus"></i>
                Cadastrar Usuário
            </a>

            @if (Model.EmDesenvolvimento)
            {
                <a asp-page="/Desenvolvimento/DadosTeste" class="btn-dados-teste">
                    <i class="bi bi-database-add"></i>
                    Dados de teste
                </a>
            }
        </div>
    </div>

    <section class="instituicoes-card usuarios-card-listagem">
    <div class="instituicoes-card-header"><div><h2>Usuários cadastrados</h2><p>Consulte, filtre e gerencie a situação dos usuários.</p></div><span class="instituicoes-contador">@Model.Usuarios.Count registro(s)</span></div>
    <form method="get" class="barra-pesquisa instituicoes-filtros">
        <div class="campo-pesquisa">
            <i class="bi bi-search"></i>
            <input type="text" name="Pesquisa" value="@Model.Pesquisa"
                   placeholder="Pesquisar por nome, e-mail ou perfil..." />
        </div>

        <div class="filtros-gerenciamento">

            <div class="campo-filtro-select">
                <label for="Situacao">
                    <i class="bi bi-toggle-on"></i>
                    Situação
                </label>
                <div class="select-filtro-wrapper">
                    <select id="Situacao" name="Situacao" class="select-filtro">
                        <option value="Todos" selected="@(Model.Situacao == "Todos" || string.IsNullOrEmpty(Model.Situacao) ? "selected" : null)">
                            Todos
                        </option>
                        <option value="Ativo" selected="@(Model.Situacao == "Ativo" ? "selected" : null)">
                            Ativo
                        </option>
                        <option value="Inativo" selected="@(Model.Situacao == "Inativo" ? "selected" : null)">
                            Inativo
                        </option>
                    </select>
                    <i class="bi bi-chevron-down select-filtro-seta"></i>
                </div>
            </div>

            <div class="campo-filtro-select">
                <label for="Perfil">
                    <i class="bi bi-person-badge"></i>
                    Perfil
                </label>
                <div class="select-filtro-wrapper">
                    <select id="Perfil" name="Perfil" class="select-filtro">
                        <option value="Todos" selected="@(Model.Perfil == "Todos" || string.IsNullOrEmpty(Model.Perfil) ? "selected" : null)">
                            Todos
                        </option>
                        <option value="Aluno" selected="@(Model.Perfil == "Aluno" ? "selected" : null)">
                            Aluno
                        </option>
                        <option value="Professor" selected="@(Model.Perfil == "Professor" ? "selected" : null)">
                            Professor
                        </option>
                        <option value="Supervisor" selected="@(Model.Perfil == "Supervisor" ? "selected" : null)">
                            Supervisor
                        </option>
                        <option value="Coordenador" selected="@(Model.Perfil == "Coordenador" ? "selected" : null)">
                            Coordenador
                        </option>
                    </select>
                    <i class="bi bi-chevron-down select-filtro-seta"></i>
                </div>
            </div>

        </div>

        <button type="submit" class="btn-pesquisar instituicoes-btn instituicoes-btn-primary">
            <i class="bi bi-search"></i>
            Pesquisar
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
        {
            <a asp-page="/Usuarios/Index" class="btn-limpar instituicoes-btn instituicoes-btn-secondary">
                Limpar
            </a>
        }

        <a asp-page="/Usuarios/Index" asp-page-handler="ExportarExcel"
           asp-route-Pesquisa="@Model.Pesquisa"
           asp-route-Situacao="@Model.Situacao"
           asp-route-Perfil="@Model.Perfil"
           asp-route-pagina="@Model.PaginaAtual"
           class="btn-pesquisar instituicoes-btn instituicoes-btn-primary">
            <i class="bi bi-file-earmark-excel"></i>
            Exportar Excel
        </a>

    </form>

    @if (Model.Usuarios.Count == 0)
    {
        <div class="usuarios-vazio">
            <i class="bi bi-people"></i>
            <p>Nenhum usuário cadastrado.</p>
        </div>
    }
    else
    {
        <div class="tabela-wrapper instituicoes-tabela-wrapper">

            <table class="tabela-usuarios instituicoes-tabela usuarios-tabela-padronizada">

                <thead>
                    <tr>
                        <th>Matrícula/Registro</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Perfil</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>

                            <td><span class="usuario-inscricao">@(usuario.Inscricao == null ? "-" : usuario.Inscricao)</span></td>

                            <td><div class="instituicoes-identificacao"><div class="instituicoes-avatar"><i class="bi bi-person"></i></div><div class="instituicoes-nome"><strong>@usuario.Nome</strong><span>Usuário do sistema</span></div></div></td>

                            <td>@usuario.Email</td>

                            <td>@usuario.Tipo</td>

                            <td>
                                @if (usuario.Ativo)
                                {
                                    <span class="registro-status ativo"><span></span>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="registro-status inativo"><span></span>
                                        Inativo
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="acoes registro-acoes">

                                    <a asp-page="/Usuarios/Cadastro" asp-route-id="@usuario.Id" asp-route-tipo="@usuario.Tipo"
                                       class="registro-acao editar">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @if (usuario.Ativo)
                                    {
                                        <form method="post" asp-page-handler="Inativar"
                                              onsubmit="return abrirConfirmacaoUsuario(this, 'inativar', 'usuário');">
                                            <input type="hidden" name="id" value="@usuario.Id" />
                                            <input type="hidden" name="tipo" value="@usuario.Tipo" />
                                            <input type="hidden" name="nome" value="@usuario.Nome" />
                                            <button type="submit" class="registro-acao inativar" title="Inativar usuário" aria-label="Inativar @usuario.Nome">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                        
                                    }
                                    @if (!usuario.Ativo)
                                    {
                                        <form method="post" asp-page-handler="Ativar"
                                              onsubmit="return abrirConfirmacaoUsuario(this, 'reativar', 'usuário');">
                                            <input type="hidden" name="id" value="@usuario.Id" />
                                            <input type="hidden" name="tipo" value="@usuario.Tipo" />
                                            <input type="hidden" name="nome" value="@usuario.Nome" />
                                            <button type="submit" class="registro-acao reativar" title="Reativar usuário" aria-label="Reativar @usuario.Nome">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        </form>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="informacao-paginacao" aria-live="polite">
            @{
                var inicio = ((Model.PaginaAtual - 1) * Model.TamanhoPagina) + 1;
                var fim = Math.Min(
                    Model.PaginaAtual * Model.TamanhoPagina,
                    Model.Usuarios.Count + ((Model.PaginaAtual - 1) * Model.TamanhoPagina)
                );
            }

            Exibindo @inicio–@fim de @((Model.TotalPaginas == 0 ? 0 : (Model.TotalPaginas - 1) * Model.TamanhoPagina +
                    Model.Usuarios.Count)) usuários
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="paginacao">

                @if (Model.PaginaAtual > 1)
                {
                    <a asp-page="/Usuarios/Index" asp-route-pagina="@(Model.PaginaAtual - 1)" asp-route-Pesquisa="@Model.Pesquisa" asp-route-Situacao="@Model.Situacao" asp-route-Perfil="@Model.Perfil"
                       class="pagina-link">
                        ← Anterior
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a asp-page="/Usuarios/Index" asp-route-pagina="@i" asp-route-Pesquisa="@Model.Pesquisa" asp-route-Situacao="@Model.Situacao" asp-route-Perfil="@Model.Perfil"
                       class="pagina-link @(i == Model.PaginaAtual ? "pagina-atual" : "")">
                        @i
                    </a>
                }

                @if (Model.PaginaAtual < Model.TotalPaginas)
                {
                    <a asp-page="/Usuarios/Index" asp-route-pagina="@(Model.PaginaAtual + 1)" asp-route-Pesquisa="@Model.Pesquisa" asp-route-Situacao="@Model.Situacao" asp-route-Perfil="@Model.Perfil"
                       class="pagina-link">
                        Próxima →
                    </a>
                }

            </div>
        }

        <!-- Modal de confirmação para ativação/inativação de usuário -->
        <div class="swes-modal-overlay" id="modalConfirmacaoUsuario" aria-hidden="true">
            <section class="swes-modal" role="dialog" aria-modal="true" aria-labelledby="tituloConfirmacaoUsuario">
                <div class="swes-modal-icone" id="iconeConfirmacaoUsuario"><i class="bi bi-exclamation-triangle"></i></div>
                <h2 id="tituloConfirmacaoUsuario">Confirmar ação</h2>
                <p id="mensagemConfirmacaoUsuario">Deseja realmente continuar?</p>
                <div class="swes-modal-acoes">
                    <button type="button" class="swes-modal-cancelar" onclick="fecharConfirmacaoUsuario()">Cancelar</button>
                    <button type="button" class="swes-modal-confirmar" id="btnConfirmarUsuario" onclick="confirmarAcaoUsuario()">Confirmar</button>
                </div>
            </section>
        </div>
    }
    </section>

</div>



<script>
    let formularioUsuarioPendente = null;

    function abrirConfirmacaoUsuario(formulario, acao, tipo) {
        formularioUsuarioPendente = formulario;
        const reativar = acao === 'reativar';
        document.getElementById('tituloConfirmacaoUsuario').textContent = reativar ? 'Reativar usuário' : 'Inativar usuário';
        document.getElementById('mensagemConfirmacaoUsuario').textContent = `Deseja realmente ${reativar ? 'reativar' : 'inativar'} este ${tipo}?`;
        document.getElementById('btnConfirmarUsuario').textContent = reativar ? 'Reativar' : 'Inativar';
        document.getElementById('btnConfirmarUsuario').classList.toggle('reativar', reativar);
        document.getElementById('iconeConfirmacaoUsuario').innerHTML = reativar ? '<i class="bi bi-person-check"></i>' : '<i class="bi bi-exclamation-triangle"></i>';
        const modal = document.getElementById('modalConfirmacaoUsuario');
        modal.classList.add('aberto');
        modal.setAttribute('aria-hidden', 'false');
        document.getElementById('btnConfirmarUsuario').focus();
        return false;
    }

    function fecharConfirmacaoUsuario() {
        const modal = document.getElementById('modalConfirmacaoUsuario');
        modal.classList.remove('aberto');
        modal.setAttribute('aria-hidden', 'true');
        formularioUsuarioPendente = null;
    }

    function confirmarAcaoUsuario() {
        if (formularioUsuarioPendente) formularioUsuarioPendente.submit();
    }

    document.getElementById('modalConfirmacaoUsuario')?.addEventListener('click', function (event) {
        if (event.target === this) fecharConfirmacaoUsuario();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') fecharConfirmacaoUsuario();
    });
</script>
