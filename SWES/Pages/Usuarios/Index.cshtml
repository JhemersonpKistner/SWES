@page
@model SWES.Pages.Usuarios.IndexModel

<div class="usuarios-container">

    <div class="usuarios-header">
        <div>
            <h1>Gerenciamento de Usuários</h1>
            <p class="usuarios-subtitulo">
                Gerencie os usuários cadastrados no sistema
            </p>
        </div>

        <div class="usuarios-botoes">
            <a asp-page="/Index" class="btn-voltar-dashboard">
                <i class="bi bi-arrow-left"></i>
                Voltar
            </a>

            <a asp-page="/Usuarios/Cadastro" class="btn-cadastrar">
                <i class="bi bi-person-plus"></i>
                Cadastrar Usuário
            </a>

            @if (Model.EmDesenvolvimento)
            {
                <a asp-page="/Desenvolvimento/DadosTeste" class="btn-dados-teste">
                    <i class="bi bi-database-add"></i>
                    Dados de teste
                </a>
            }
        </div>
    </div>

    <form method="get" class="barra-pesquisa">
        <div class="campo-pesquisa">
            <i class="bi bi-search"></i>
            <input type="text" name="Pesquisa" value="@Model.Pesquisa"
                   placeholder="Pesquisar por nome, e-mail ou perfil..." />
        </div>

        <button type="submit" class="btn-pesquisar">
            <i class="bi bi-search"></i>
            Pesquisar
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
        {
            <a asp-page="/Usuarios/Index" class="btn-limpar">
                Limpar
            </a>
        }

        <a asp-page="/Usuarios/Index"
           asp-page-handler="ExportarExcel"
           asp-route-Pesquisa="@Model.Pesquisa"
           class="btn-pesquisar">
            <i class="bi bi-file-earmark-excel"></i>
            Exportar Excel
        </a>

    </form>

    @if (Model.Usuarios.Count == 0)
    {
        <div class="usuarios-vazio">
            <i class="bi bi-people"></i>
            <p>Nenhum usuário cadastrado.</p>
        </div>
    }
    else
    {
        <div class="tabela-wrapper">

            <table class="tabela-usuarios">

                <thead>
                    <tr>
                        <th>Matrícula/Registro</th>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Perfil</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var usuario in Model.Usuarios)
                    {
                        <tr>

                            <td>@(usuario.Inscricao == null ? "-" : usuario.Inscricao)</td>

                            <td>@usuario.Nome</td>

                            <td>@usuario.Email</td>

                            <td>@usuario.Tipo</td>

                            <td>
                                @if (usuario.Ativo)
                                {
                                    <span class="status status-ativo">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="status status-inativo">
                                        Inativo
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="acoes">

                                    <a asp-page="/Usuarios/Cadastro" asp-route-id="@usuario.Id" asp-route-tipo="@usuario.Tipo"
                                       class="btn-editar">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>

                                    @if (usuario.Ativo)
                                    {
                                        <button type="button" class="btn-inativar" onclick="abrirModalInativacao(
                                            @usuario.Id,
                                            '@usuario.Tipo',
                                            '@usuario.Nome'
                                            )">

                                            <i class="bi bi-person-x"></i>
                                            Inativar

                                        </button>
                        
                                    }
                                    @if (!usuario.Ativo)
                                    {
                                        <button type="button" class="btn-reativar" onclick="abrirModalReativacao(
                                            @usuario.Id,
                                            '@usuario.Tipo',
                                            '@usuario.Nome'
                                            )">

                                            <i class="bi bi-person-check"></i>
                                            Reativar

                                        </button>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="informacao-paginacao" aria-live="polite">
            @{
                var inicio = ((Model.PaginaAtual - 1) * Model.TamanhoPagina) + 1;
                var fim = Math.Min(
                    Model.PaginaAtual * Model.TamanhoPagina,
                    Model.Usuarios.Count + ((Model.PaginaAtual - 1) * Model.TamanhoPagina)
                );
            }

            Exibindo @inicio–@fim de @((Model.TotalPaginas == 0 ? 0 : (Model.TotalPaginas - 1) * Model.TamanhoPagina + Model.Usuarios.Count)) usuários
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="paginacao">

                @if (Model.PaginaAtual > 1)
                {
                    <a asp-page="/Usuarios/Index" asp-route-pagina="@(Model.PaginaAtual - 1)" asp-route-Pesquisa="@Model.Pesquisa"
                       class="pagina-link">
                        ← Anterior
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <a asp-page="/Usuarios/Index" asp-route-pagina="@i" asp-route-Pesquisa="@Model.Pesquisa"
                       class="pagina-link @(i == Model.PaginaAtual ? "pagina-atual" : "")">
                        @i
                    </a>
                }

                @if (Model.PaginaAtual < Model.TotalPaginas)
                {
                    <a asp-page="/Usuarios/Index" asp-route-pagina="@(Model.PaginaAtual + 1)" asp-route-Pesquisa="@Model.Pesquisa"
                       class="pagina-link">
                        Próxima →
                    </a>
                }

            </div>
        }

        <!-- MODAL DE INATIVAÇÃO -->

        <div id="modalInativacao" class="modal-inativacao">

            <div class="modal-conteudo">

                <div class="modal-icone">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h2>Inativar usuário</h2>

                <p>
                    Tem certeza que deseja inativar este usuário?
                </p>

                <div class="modal-dados">

                    <p>
                        <strong>Nome:</strong>
                        <span id="nomeUsuarioModal"></span>
                    </p>

                    <p>
                        <strong>Perfil:</strong>
                        <span id="tipoUsuarioModal"></span>
                    </p>

                </div>

                <form method="post" asp-page-handler="Inativar">

                    <input type="hidden" id="idUsuarioModal" name="id" />

                    <input type="hidden" id="tipoUsuarioModalInput" name="tipo" />

                    <div class="modal-acoes">

                        <button type="button" class="btn-cancelar" onclick="fecharModalInativacao()">

                            Cancelar

                        </button>

                        <button type="submit" class="btn-confirmar">

                            Inativar

                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- MODAL DE REATIVAÇÃO -->

        <div id="modalReativacao" class="modal-inativacao">

            <div class="modal-conteudo">

                <div class="modal-icone">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>

                <h2>Reativar usuário</h2>

                <p>
                    Tem certeza que deseja reativar este usuário?
                </p>

                <div class="modal-dados">

                    <p>
                        <strong>Nome:</strong>
                        <span id="nomeUsuarioReativacaoModal"></span>
                    </p>

                    <p>
                        <strong>Perfil:</strong>
                        <span id="tipoUsuarioReativacaoModal"></span>
                    </p>

                </div>

                <form method="post" asp-page-handler="Ativar">

                    <input type="hidden" id="idUsuarioReativacaoModal" name="id" />

                    <input type="hidden" id="tipoUsuarioReativacaoModalInput" name="tipo" />

                    <div class="modal-acoes">

                        <button type="button" class="btn-cancelar" onclick="fecharModalReativacao()">

                            Cancelar

                        </button>

                        <button type="submit" class="btn-confirmar">

                            Reativar

                        </button>

                    </div>

                </form>

            </div>

        </div>

    }

</div>



<script>

    function abrirModalInativacao(id, tipo, nome) {

        document.getElementById("idUsuarioModal").value = id;

        document.getElementById("tipoUsuarioModalInput").value = tipo;

        document.getElementById("nomeUsuarioModal").textContent = nome;

        document.getElementById("tipoUsuarioModal").textContent = tipo;

        document.getElementById("modalInativacao").style.display = "flex";
    }

    function abrirModalReativacao(id, tipo, nome) {

        document.getElementById("idUsuarioReativacaoModal").value = id;

        document.getElementById("tipoUsuarioReativacaoModalInput").value = tipo;

        document.getElementById("nomeUsuarioReativacaoModal").textContent = nome;

        document.getElementById("tipoUsuarioReativacaoModal").textContent = tipo;

        document.getElementById("modalReativacao").style.display = "flex";
    }


    function fecharModalInativacao() {

        document.getElementById("modalInativacao").style.display = "none";

    }
    function fecharModalReativacao() {

        document.getElementById("modalReativacao").style.display = "none";

    }

</script>