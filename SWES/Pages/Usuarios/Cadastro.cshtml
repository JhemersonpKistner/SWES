@page
@model SWES.Pages.Usuarios.CadastroModel
@{
    var dataMaxima = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="cadastro-container">

    <div class="cadastro-header">

        <div>

            <h1>
                @(Model.Usuario.Id.HasValue
                    ? "Editar Usuário"
                    : "Cadastrar Usuário")
            </h1>

            <p>
                @(Model.Usuario.Id.HasValue
                    ? "Atualize os dados do usuário"
                    : "Preencha os dados para cadastrar um novo usuário")
            </p>

        </div>

        <a asp-page="/Usuarios/Index" class="btn-voltar">

            <i class="bi bi-arrow-left"></i>
            Voltar

        </a>

    </div>


    <div class="cadastro-card">

        @if (!string.IsNullOrEmpty(Model.Erro))
        {
            <div class="mensagem-erro">

                <i class="bi bi-exclamation-circle"></i>

                <div>
                    <strong>Atenção:</strong>
                    <span>@Model.Erro</span>
                </div>

            </div>
        }

        <div asp-validation-summary="ModelOnly" class="validacao">
        </div>


        <form method="post">

            <input type="hidden" asp-for="Usuario.Id" />


            <!-- DADOS COMUNS -->

            <div class="form-grid">

                <div class="campo">

                    <label asp-for="Usuario.Nome">
                        Nome completo
                    </label>

                    <input asp-for="Usuario.Nome" maxlength="60" placeholder="Nome e sobrenome" />

                    <span asp-validation-for="Usuario.Nome" class="text-danger">
                    </span>

                </div>


                <div class="campo">

                    <label asp-for="Usuario.Email">
                        E-mail
                    </label>

                    <input asp-for="Usuario.Email" type="email" maxlength="100" placeholder="Digite o e-mail" />

                    <span asp-validation-for="Usuario.Email" class="text-danger">
                    </span>

                </div>


                @if (!Model.Usuario.Id.HasValue)
                {
                    <div class="campo">

                        <label asp-for="Usuario.Senha">
                            Senha
                        </label>

                        <input type="password" id="Usuario_Senha" name="Usuario.Senha" value="@Model.Usuario.Senha"
                               maxlength="100" autocomplete="new-password" placeholder="Digite a senha" />

                        <span asp-validation-for="Usuario.Senha" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.ConfirmacaoSenha">
                            Confirmar senha
                        </label>

                        <input type="password" id="Usuario_ConfirmacaoSenha" name="Usuario.ConfirmacaoSenha"
                               value="@Model.Usuario.ConfirmacaoSenha" maxlength="100" autocomplete="new-password"
                               placeholder="Digite a senha novamente" />

                        <span asp-validation-for="Usuario.ConfirmacaoSenha" class="text-danger">
                        </span>

                    </div>
                }


                <div class="campo">

                    <label asp-for="Usuario.Telefone">
                        Telefone
                    </label>

                    <input asp-for="Usuario.Telefone" id="telefone" maxlength="15" placeholder="(00) 00000-0000" />

                    <span asp-validation-for="Usuario.Telefone" class="text-danger">
                    </span>

                </div>


                <div class="campo">

                    <label asp-for="Usuario.TelefoneSecundario">
                        Telefone 2 (opcional)
                    </label>

                    <input asp-for="Usuario.TelefoneSecundario" id="telefone2" maxlength="15"
                           placeholder="(00) 00000-0000" />

                    <span asp-validation-for="Usuario.TelefoneSecundario" class="text-danger">
                    </span>

                </div>


                <div class="campo">

                    <label asp-for="Usuario.CPF">
                        CPF
                    </label>

                    <input asp-for="Usuario.CPF" id="cpf" maxlength="14" placeholder="000.000.000-00" />

                    <span asp-validation-for="Usuario.CPF" class="text-danger">
                    </span>

                </div>


                <div class="campo">

                    <label asp-for="Usuario.Tipo">
                        Tipo de usuário
                    </label>

                    <select asp-for="Usuario.Tipo" id="tipoUsuario">

                        <option value="">
                            Selecione...
                        </option>

                        <option value="Aluno">
                            Aluno
                        </option>

                        <option value="Professor">
                            Professor
                        </option>

                        <option value="Supervisor">
                            Supervisor
                        </option>

                        <option value="Coordenador">
                            Coordenador
                        </option>

                    </select>

                    <span asp-validation-for="Usuario.Tipo" class="text-danger">
                    </span>

                </div>

                <div class="campo">

                    <label asp-for="Usuario.InstituicaoEnsinoId">
                        Instituição de ensino
                    </label>

                    <select asp-for="Usuario.InstituicaoEnsinoId" id="instituicaoEnsino">

                        <option value="">Selecione...</option>

                        @foreach (var unidade in Model.Opcoes.UnidadesConcedentes)
                        {
                            if (unidade.Nome.EndsWith("(Instituição de ensino)"))
                            {
                                <option value="@unidade.Id">
                                    @unidade.Nome
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="Usuario.InstituicaoEnsinoId" class="text-danger">
                    </span>

                </div>
            </div>


            <!-- DADOS PESSOAIS -->

            <div class="campos-especificos" style="display:block;">

                <div class="titulo-secao">

                    <i class="bi bi-person-vcard"></i>

                    <h3>Dados Pessoais</h3>

                </div>


                <div class="form-grid">

                    <div class="campo">

                        <label asp-for="Usuario.RG">
                            RG
                        </label>

                        <input asp-for="Usuario.RG" maxlength="20" />

                        <span asp-validation-for="Usuario.RG" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.OrgaoExpedidor">
                            Órgão expedidor
                        </label>

                        <input asp-for="Usuario.OrgaoExpedidor" maxlength="20" placeholder="Ex.: SSP/GO" />

                        <span asp-validation-for="Usuario.OrgaoExpedidor" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.EstadoCivil">
                            Estado civil
                        </label>

                        <select asp-for="Usuario.EstadoCivil">

                            <option value="">
                                Selecione...
                            </option>

                            @foreach (var estadoCivil in SWES.ViewModels.UsuarioCadastroViewModel.EstadosCivis)
                            {
                                <option value="@estadoCivil">
                                    @estadoCivil
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Usuario.EstadoCivil" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Nacionalidade">
                            Nacionalidade
                        </label>

                        <input asp-for="Usuario.Nacionalidade" maxlength="50" placeholder="Ex.: Brasileira" />

                        <span asp-validation-for="Usuario.Nacionalidade" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Endereco">
                            Endereço
                        </label>

                        <input asp-for="Usuario.Endereco" maxlength="150" placeholder="Rua, número e complemento" />

                        <span asp-validation-for="Usuario.Endereco" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Bairro">
                            Bairro
                        </label>

                        <input asp-for="Usuario.Bairro" maxlength="80" />

                        <span asp-validation-for="Usuario.Bairro" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Cidade">
                            Cidade
                        </label>

                        <input asp-for="Usuario.Cidade" maxlength="80" />

                        <span asp-validation-for="Usuario.Cidade" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Estado">
                            Estado (UF)
                        </label>

                        <select asp-for="Usuario.Estado">

                            <option value="">
                                Selecione...
                            </option>

                            @foreach (var uf in SWES.ViewModels.UsuarioCadastroViewModel.Ufs)
                            {
                                <option value="@uf">
                                    @uf
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Usuario.Estado" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.CEP">
                            CEP
                        </label>

                        <input asp-for="Usuario.CEP" id="cep" maxlength="9" placeholder="00000-000" />

                        <span asp-validation-for="Usuario.CEP" class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- ALUNO -->

            <div id="camposAluno" class="campos-especificos" style="display:none;">

                <div class="titulo-secao">

                    <i class="bi bi-mortarboard"></i>

                    <h3>Dados do Aluno</h3>

                </div>


                <div class="form-grid">

                    <div class="campo">

                        <label asp-for="Usuario.Matricula">
                            Matrícula
                        </label>

                        <input asp-for="Usuario.Matricula" class="form-control" maxlength="10" inputmode="numeric"
                               oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10);" />

                        <span asp-validation-for="Usuario.Matricula" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.CursoId">
                            Curso
                        </label>

                        <select asp-for="Usuario.CursoId"
                                asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Opcoes.Cursos, "Id", "Nome"))">
                            <option value="">Selecione...</option>
                        </select>

                        <span asp-validation-for="Usuario.CursoId" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Turno">
                            Turno
                        </label>

                        <select asp-for="Usuario.Turno">

                            <option value="">
                                Selecione...
                            </option>

                            <option value="Matutino">
                                Matutino
                            </option>

                            <option value="Vespertino">
                                Vespertino
                            </option>

                            <option value="Noturno">
                                Noturno
                            </option>

                            <option value="Integral">
                                Integral
                            </option>

                        </select>

                        <span asp-validation-for="Usuario.Turno" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.Semestre">
                            Semestre
                        </label>

                        <select asp-for="Usuario.Semestre">

                            <option value="">
                                Selecione...
                            </option>

                            <option value="1º semestre">
                                1º semestre
                            </option>

                            <option value="2º semestre">
                                2º semestre
                            </option>

                            <option value="3º semestre">
                                3º semestre
                            </option>

                            <option value="4º semestre">
                                4º semestre
                            </option>

                            <option value="5º semestre">
                                5º semestre
                            </option>

                            <option value="6º semestre">
                                6º semestre
                            </option>

                            <option value="7º semestre">
                                7º semestre
                            </option>

                            <option value="8º semestre">
                                8º semestre
                            </option>

                            <option value="9º semestre">
                                9º semestre
                            </option>

                            <option value="10º semestre">
                                10º semestre
                            </option>

                        </select>

                        <span asp-validation-for="Usuario.Semestre" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.DataNasc">
                            Data de nascimento
                        </label>

                        <input asp-for="Usuario.DataNasc" type="date" class="form-control" id="Usuario_DataNasc"
                               min="1900-01-01" max="@dataMaxima" inputmode="numeric" />

                        <span asp-validation-for="Usuario.DataNasc" class="text-danger"></span>
                        <span id="mensagemDataNascimento" class="text-danger"></span>

                    </div>

                </div>

            </div>


            <!-- PROFESSOR -->

            <div id="camposProfessor" class="campos-especificos" style="display:none;">

                <div class="titulo-secao">

                    <i class="bi bi-person-badge"></i>

                    <h3>Dados do Professor</h3>

                </div>


                <div class="form-grid">

                    <div class="campo">

                        <label asp-for="Usuario.Registro">
                            Registro
                        </label>

                        <input asp-for="Usuario.Registro" maxlength="10" inputmode="numeric"
                               oninput="this.value=this.value.replace(/[^0-9]/g,'')" />

                        <span asp-validation-for="Usuario.Registro" class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="campo campo-cursos-professor">

                    <label class="label-cursos-professor">
                        Instituições de ensino vinculadas ao professor
                    </label>

                    <div class="lista-cursos-professor">

                        @foreach (var unidade in Model.Opcoes.UnidadesConcedentes)
                        {
                            if (unidade.Nome.EndsWith("(Instituição de ensino)"))
                            {
                                <label class="opcao-curso-professor">

                                    <input type="checkbox" name="Usuario.InstituicoesProfessorIds" value="@unidade.Id"
                                           checked="@(Model.Usuario.InstituicoesProfessorIds.Contains(unidade.Id))" />

                                    <span>@unidade.Nome</span>

                                </label>
                            }
                        }

                    </div>

                    <span asp-validation-for="Usuario.InstituicoesProfessorIds" class="text-danger d-block mt-2">
                    </span>

                </div>

                <div class="campo campo-cursos-professor">

                    <label class="label-cursos-professor">
                        Cursos que leciona
                    </label>

                    <div class="lista-cursos-professor">

                        @foreach (var curso in Model.Opcoes.Cursos)
                        {
                            <label class="opcao-curso-professor">
                                <input type="checkbox" name="Usuario.CursosProfessorIds" value="@curso.Id"
                                       checked="@(Model.Usuario.CursosProfessorIds.Contains(curso.Id))" />

                                <span>@curso.Nome</span>
                            </label>
                        }

                    </div>

                    <span asp-validation-for="Usuario.CursosProfessorIds" class="text-danger d-block mt-2">
                    </span>

                </div>

            </div>


            <!-- SUPERVISOR -->

            <div id="camposSupervisor" class="campos-especificos" style="display:none;">

                <div class="titulo-secao">

                    <i class="bi bi-briefcase"></i>

                    <h3>Dados do Supervisor</h3>

                </div>


                <div class="form-grid">

                    <div class="campo">

                        <label asp-for="Usuario.Cargo">
                            Cargo
                        </label>

                        <input asp-for="Usuario.Cargo" maxlength="60" />

                        <span asp-validation-for="Usuario.Cargo" class="text-danger">
                        </span>

                    </div>


                    <div class="campo">

                        <label asp-for="Usuario.UnidadeConcedenteId">
                            Unidade concedente
                        </label>

                        <select asp-for="Usuario.UnidadeConcedenteId"
                                asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Opcoes.UnidadesConcedentes, "Id", "Nome"))">
                            <option value="">Selecione...</option>
                        </select>

                        <span asp-validation-for="Usuario.UnidadeConcedenteId" class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <!-- COORDENADOR -->

            <div id="camposCoordenador" class="campos-especificos" style="display:none;">

                <div class="titulo-secao">

                    <i class="bi bi-person-gear"></i>

                    <h3>Dados do Coordenador</h3>

                </div>


                <div class="form-grid">

                    <div class="campo">

                        <label asp-for="Usuario.Setor">
                            Setor
                        </label>

                        <input asp-for="Usuario.Setor" maxlength="100" />

                        <span asp-validation-for="Usuario.Setor" class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <div class="form-acoes">

                <a asp-page="/Usuarios/Index" class="btn-cancelar">

                    Cancelar

                </a>

                <button type="submit" class="btn-salvar">

                    <i class="bi bi-check-lg"></i>

                    @(Model.Usuario.Id.HasValue
                        ? "Salvar Alterações"
                        : "Cadastrar")

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function atualizarCamposEspecificos() {
            const tipo = document.getElementById("tipoUsuario").value;

            document.getElementById("camposAluno").style.display = tipo === "Aluno" ? "block" : "none";
            document.getElementById("camposProfessor").style.display = tipo === "Professor" ? "block" : "none";
            document.getElementById("camposSupervisor").style.display = tipo === "Supervisor" ? "block" : "none";
            document.getElementById("camposCoordenador").style.display = tipo === "Coordenador" ? "block" : "none";
        }

        function formatarTelefone(valor) {
            let numeros = (valor || "").replace(/\D/g, "").slice(0, 11);
            if (numeros.length <= 10) {
                numeros = numeros.replace(/^(\d{2})(\d)/, "($1) $2");
                numeros = numeros.replace(/(\d{4})(\d)/, "$1-$2");
            } else {
                numeros = numeros.replace(/^(\d{2})(\d)/, "($1) $2");
                numeros = numeros.replace(/(\d{5})(\d)/, "$1-$2");
            }
            return numeros;
        }

        function formatarCpf(valor) {
            let numeros = (valor || "").replace(/\D/g, "").slice(0, 11);
            numeros = numeros.replace(/(\d{3})(\d)/, "$1.$2");
            numeros = numeros.replace(/(\d{3})(\d)/, "$1.$2");
            numeros = numeros.replace(/(\d{3})(\d)/, "$1-$2");
            return numeros;
        }

        function formatarCep(valor) {
            let numeros = (valor || "").replace(/\D/g, "").slice(0, 8);
            numeros = numeros.replace(/^(\d{5})(\d)/, "$1-$2");
            return numeros;
        }

        function sincronizarInstituicaoProfessor() {
            const tipo = document.getElementById("tipoUsuario").value;
            const instituicao = document.getElementById("instituicaoEnsino");

            if (tipo !== "Professor" || !instituicao.value) {
                return;
            }

            const checkbox = document.querySelector(
                `input[name="Usuario.InstituicoesProfessorIds"][value="${instituicao.value}"]`
            );

            if (checkbox) {
                checkbox.checked = true;
            }
        }

        document.getElementById("instituicaoEnsino")
            .addEventListener("change", sincronizarInstituicaoProfessor);

        document.getElementById("tipoUsuario")
            .addEventListener("change", sincronizarInstituicaoProfessor);

        sincronizarInstituicaoProfessor();

        document.querySelectorAll(
            'input[name="Usuario.InstituicoesProfessorIds"]'
        ).forEach(checkbox => {
            checkbox.addEventListener("change", function () {
                sincronizarInstituicaoProfessor();
            });
        });

        const tipoUsuario = document.getElementById("tipoUsuario");
        tipoUsuario.addEventListener("change", atualizarCamposEspecificos);
        atualizarCamposEspecificos();

        const telefone = document.getElementById("telefone");
        const telefone2 = document.getElementById("telefone2");
        const cpf = document.getElementById("cpf");
        const cep = document.getElementById("cep");

        if (telefone) {
            telefone.value = formatarTelefone(telefone.value);
            telefone.addEventListener("input", () => telefone.value = formatarTelefone(telefone.value));
        }

        if (telefone2) {
            telefone2.value = formatarTelefone(telefone2.value);
            telefone2.addEventListener("input", () => telefone2.value = formatarTelefone(telefone2.value));
        }

        if (cpf) {
            cpf.value = formatarCpf(cpf.value);
            cpf.addEventListener("input", () => cpf.value = formatarCpf(cpf.value));
        }

        if (cep) {
            cep.value = formatarCep(cep.value);
            cep.addEventListener("input", () => cep.value = formatarCep(cep.value));
        }

        const dataNascimento = document.getElementById("Usuario_DataNasc");
        const mensagemData = document.getElementById("mensagemDataNascimento");

        function validarDataNascimentoNoCliente() {
            if (!dataNascimento) return;

            const valor = dataNascimento.value;
            if (!valor) {
                if (mensagemData) mensagemData.textContent = "";
                return;
            }

            // O input date permite anos ISO com mais de quatro dígitos em alguns navegadores.
            // Se isso acontecer, restringimos o ano para quatro dígitos antes do envio.
            const partes = valor.split("-");
            if (partes[0] && partes[0].length > 4) {
                dataNascimento.value = `${partes[0].slice(0, 4)}-${partes[1] || "01"}-${partes[2] || "01"}`;
            }

            const data = new Date(dataNascimento.value + "T00:00:00");
            const minimo = new Date("1900-01-01T00:00:00");
            const hoje = new Date();
            hoje.setHours(0, 0, 0, 0);

            if (data < minimo) {
                mensagemData.textContent = "A data de nascimento deve ser a partir de 01/01/1900.";
            } else if (data > hoje) {
                mensagemData.textContent = "A data de nascimento não pode ser futura.";
            } else {
                mensagemData.textContent = "";
            }
        }

        if (dataNascimento) {
            dataNascimento.addEventListener("input", validarDataNascimentoNoCliente);
            dataNascimento.addEventListener("change", validarDataNascimentoNoCliente);
            dataNascimento.addEventListener("blur", validarDataNascimentoNoCliente);
            validarDataNascimentoNoCliente();
        }
    </script>

}