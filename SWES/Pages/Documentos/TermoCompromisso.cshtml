@page
@model SWES.Pages.Documentos.TermoCompromissoModel

@{
    ViewData["Title"] = "Termo de Compromisso";
}

<div class="container-fluid py-4">
    <h2>
        <i class="bi bi-file-earmark-text"></i>
        Termo de Compromisso
    </h2>

    <p class="text-muted">
        Preencha os dados do termo de compromisso de estágio.
    </p>

    <form method="post">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    Informações do documento
                </h5>

                <div class="mb-3">
                    <label asp-for="EstagioId" class="form-label">
                        Estágio / Número de protocolo
                    </label>

                    <select asp-for="EstagioId" class="form-select" required>
                        <option value="">Selecione um estágio...</option>

                        @foreach (var estagio in Model.EstagiosDisponiveis)
                        {
                            <option value="@estagio.Id">
                                @estagio.Protocolo - @estagio.Tipo
                            </option>
                        }
                    </select>

                    <span asp-validation-for="EstagioId" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label for="nomeAluno" class="form-label">
                        Nome do aluno
                    </label>
                    <input type="text" id="nomeAluno" name="NomeAluno" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label for="instituicaoEnsino" class="form-label">
                        Instituição de ensino
                    </label>
                    <input type="text" id="instituicaoEnsino" name="InstituicaoEnsino" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label for="unidadeConcedente" class="form-label">
                        Unidade concedente
                    </label>
                    <input type="text" id="unidadeConcedente" name="UnidadeConcedente" class="form-control" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="dataInicio" class="form-label">
                            Data de início
                        </label>
                        <input type="date" id="dataInicio" name="DataInicio" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="dataFim" class="form-label">
                            Data de término
                        </label>
                        <input type="date" id="dataFim" name="DataFim" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="atividades" class="form-label">
                        Atividades previstas
                    </label>
                    <textarea id="atividades" name="Atividades" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i>
                Salvar documento
            </button>

            <a href="/Documentos/Index" class="btn btn-outline-secondary">
                Voltar
            </a>
        </div>
    </form>
</div>
