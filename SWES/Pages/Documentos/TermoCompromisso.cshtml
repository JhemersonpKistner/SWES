@page
@model SWES.Pages.Documentos.TermoCompromissoModel

@{
    ViewData["Title"] = "Termo de Compromisso";
}

<div class="documentos-page documentos-form-page">
    <div class="documentos-header">
        <div>
            <span class="documentos-eyebrow"><i class="bi bi-file-earmark-text"></i> DOCUMENTAÇÃO DE ESTÁGIO</span>
            <h1>Termo de Compromisso</h1>
            <p>Preencha os dados necessários para formalizar o termo de compromisso de estágio.</p>
        </div>
        <a href="/Documentos/Index" class="documentos-btn documentos-btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar para documentos
        </a>
    </div>

    <div class="documentos-form-card">
        <div class="documentos-form-cabecalho">
            <div class="documentos-form-icone azul"><i class="bi bi-file-earmark-text"></i></div>
            <div>
                <h2>Informações do documento</h2>
                <p>Informe os dados do estágio, do aluno e das instituições envolvidas.</p>
            </div>
        </div>

        <form method="post">
            <div class="documentos-form-grid">
                <div class="documentos-campo documentos-campo-largo">
                    <label asp-for="EstagioId">Estágio / Número de protocolo <span class="campo-obrigatorio">*</span></label>
                    <div class="documentos-input">
                        <i class="bi bi-card-list"></i>
                        <select asp-for="EstagioId" required>
                            <option value="">Selecione um estágio...</option>
                            @foreach (var estagio in Model.EstagiosDisponiveis)
                            {
                                <option value="@estagio.Id">@estagio.Protocolo - @estagio.Tipo</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="EstagioId" class="documentos-validacao"></span>
                </div>

                <div class="documentos-campo">
                    <label for="nomeAluno">Nome do aluno <span class="campo-obrigatorio">*</span></label>
                    <div class="documentos-input">
                        <i class="bi bi-person"></i>
                        <input type="text" id="nomeAluno" name="NomeAluno" placeholder="Nome completo do aluno" required />
                    </div>
                </div>

                <div class="documentos-campo">
                    <label for="instituicaoEnsino">Instituição de ensino <span class="campo-obrigatorio">*</span></label>
                    <div class="documentos-input">
                        <i class="bi bi-mortarboard"></i>
                        <input type="text" id="instituicaoEnsino" name="InstituicaoEnsino" placeholder="Nome da instituição" required />
                    </div>
                </div>

                <div class="documentos-campo documentos-campo-largo">
                    <label for="unidadeConcedente">Unidade concedente <span class="campo-obrigatorio">*</span></label>
                    <div class="documentos-input">
                        <i class="bi bi-building"></i>
                        <input type="text" id="unidadeConcedente" name="UnidadeConcedente" placeholder="Nome da empresa ou instituição concedente" required />
                    </div>
                </div>

                <div class="documentos-campo">
                    <label for="dataInicio">Data de início <span class="campo-obrigatorio">*</span></label>
                    <div class="documentos-input">
                        <i class="bi bi-calendar3"></i>
                        <input type="date" id="dataInicio" name="DataInicio" required />
                    </div>
                </div>

                <div class="documentos-campo">
                    <label for="dataFim">Data de término <span class="campo-obrigatorio">*</span></label>
                    <div class="documentos-input">
                        <i class="bi bi-calendar-check"></i>
                        <input type="date" id="dataFim" name="DataFim" required />
                    </div>
                </div>

                <div class="documentos-campo documentos-campo-largo">
                    <label for="atividades">Atividades previstas</label>
                    <textarea id="atividades" name="Atividades" rows="5" placeholder="Descreva as atividades previstas para o estágio..."></textarea>
                </div>
            </div>

            <div class="documentos-form-nota">
                <i class="bi bi-info-circle"></i>
                Os campos marcados com asterisco são obrigatórios.
            </div>

            <div class="documentos-form-acoes">
                <a href="/Documentos/Index" class="documentos-btn documentos-btn-secondary">Cancelar</a>
                <button type="submit" class="documentos-btn documentos-btn-primary">
                    <i class="bi bi-check-lg"></i> Salvar documento
                </button>
            </div>
        </form>
    </div>
</div>
