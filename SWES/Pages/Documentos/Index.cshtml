@page
@model SWES.Pages.Documentos.IndexModel

@{
    ViewData["Title"] = "Documentos";
}

<div class="documentos-page">
    <div class="documentos-header">
        <div>
            <span class="documentos-eyebrow">
                <i class="bi bi-folder2-open"></i>
                GESTÃO DE ESTÁGIOS
            </span>
            <h1>Documentos</h1>
            <p>Preencha, consulte e acompanhe os documentos relacionados aos estágios.</p>
        </div>
    </div>

    @if (TempData["Mensagem"] is string mensagem)
    {
        <div class="documentos-alerta" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensagem</span>
        </div>
    }

    <section class="documentos-secao">
        <div class="documentos-secao-cabecalho">
            <div>
                <h2>Modelos disponíveis</h2>
                <p>Escolha o documento que deseja preencher.</p>
            </div>
            <span class="documentos-contador">3 modelos</span>
        </div>

        <div class="documentos-modelos">
            <article class="documentos-modelo">
                <div class="documentos-modelo-icone azul"><i class="bi bi-file-earmark-text"></i></div>
                <div class="documentos-modelo-conteudo">
                    <span class="documentos-modelo-tipo">FORMALIZAÇÃO</span>
                    <h3>Termo de Compromisso</h3>
                    <p>Preencha as informações do termo de compromisso de estágio.</p>
                </div>
                <a href="/Documentos/TermoCompromisso" class="documentos-btn documentos-btn-primary">
                    <i class="bi bi-pencil-square"></i> Preencher documento
                </a>
            </article>

            <article class="documentos-modelo">
                <div class="documentos-modelo-icone verde"><i class="bi bi-calendar-check"></i></div>
                <div class="documentos-modelo-conteudo">
                    <span class="documentos-modelo-tipo">ACOMPANHAMENTO</span>
                    <h3>Formulário de Frequência</h3>
                    <p>Registre a frequência e as atividades realizadas durante o estágio.</p>
                </div>
                <a href="/Documentos/FormularioFrequencia" class="documentos-btn documentos-btn-primary">
                    <i class="bi bi-pencil-square"></i> Preencher documento
                </a>
            </article>

            <article class="documentos-modelo">
                <div class="documentos-modelo-icone roxo"><i class="bi bi-journal-text"></i></div>
                <div class="documentos-modelo-conteudo">
                    <span class="documentos-modelo-tipo">ENCERRAMENTO / AVALIAÇÃO</span>
                    <h3>Relatório de Estágio</h3>
                    <p>Descreva as atividades desenvolvidas e registre suas considerações finais.</p>
                </div>
                <a href="/Documentos/RelatorioEstagio" class="documentos-btn documentos-btn-primary">
                    <i class="bi bi-pencil-square"></i> Preencher documento
                </a>
            </article>
        </div>
    </section>

    <section class="documentos-secao documentos-salvos">
        <div class="documentos-secao-cabecalho">
            <div>
                <h2>Documentos preenchidos</h2>
                <p>Consulte os documentos já registrados no sistema.</p>
            </div>
            <span class="documentos-contador">@Model.DocumentosSalvos.Count documento(s)</span>
        </div>

        @if (Model.DocumentosSalvos.Any())
        {
            <div class="documentos-tabela-wrapper">
                <table class="documentos-tabela">
                    <thead>
                        <tr>
                            <th>Documento</th>
                            <th>Protocolo</th>
                            <th>Data de criação</th>
                            <th class="documentos-coluna-acoes">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var documento in Model.DocumentosSalvos)
                        {
                            <tr>
                                <td>
                                    <div class="documentos-identificacao">
                                        <div class="documentos-arquivo-icone"><i class="bi bi-file-earmark-check"></i></div>
                                        <strong>@documento.Tipo</strong>
                                    </div>
                                </td>
                                <td>
                                    @if (documento.Estagio != null)
                                    {
                                        <span class="documentos-protocolo">@documento.Estagio.Protocolo</span>
                                    }
                                    else
                                    {
                                        <span class="documentos-nao-vinculado">Não vinculado</span>
                                    }
                                </td>
                                <td>@documento.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-page="/Documentos/Visualizar" asp-route-id="@documento.Id"
                                       class="documentos-acao" title="Visualizar documento">
                                        <i class="bi bi-eye"></i> Visualizar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="documentos-vazio">
                <div class="documentos-vazio-icone"><i class="bi bi-folder2"></i></div>
                <h3>Nenhum documento preenchido</h3>
                <p>Os documentos que forem preenchidos aparecerão nesta área.</p>
            </div>
        }
    </section>
</div>
