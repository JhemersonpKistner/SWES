@page "{id:int}"
@model SWES.Pages.Documentos.VisualizarModel

@{
    ViewData["Title"] = "Visualizar documento";
}

<div class="documentos-page documentos-visualizar-page">
    <div class="documentos-header documentos-header-visualizar">
        <div>
            <span class="documentos-eyebrow"><i class="bi bi-file-earmark-check"></i> DOCUMENTAÇÃO DE ESTÁGIO</span>
            <h1>@Model.Documento.Tipo</h1>
            <p>Visualize os dados registrados e imprima ou salve uma cópia do documento.</p>
        </div>
        <div class="documentos-header-acoes">
            <button type="button" class="documentos-btn documentos-btn-primary" onclick="window.print()">
                <i class="bi bi-printer"></i> Imprimir / Salvar PDF
            </button>
            <a href="/Documentos/Index" class="documentos-btn documentos-btn-secondary">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="documentos-visualizacao-card">
        <div id="identificacaoDocumento" class="documentos-protocolo-info">
            <div>
                <span class="documentos-dado-label">Número de protocolo</span>
                @if (Model.Documento.Estagio != null)
                {
                    <strong>@Model.Documento.Estagio.Protocolo</strong>
                }
                else
                {
                    <strong class="text-muted">Não vinculado</strong>
                }
            </div>
            <div>
                <span class="documentos-dado-label">Documento criado em</span>
                <strong>@Model.Documento.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
        </div>

        <div class="documentos-visualizacao-titulo">
            <div class="documentos-form-icone azul"><i class="bi bi-file-earmark-text"></i></div>
            <div>
                <h2>Informações do documento</h2>
                <p>Dados informados no momento do preenchimento.</p>
            </div>
        </div>

        <div id="dadosDocumento" class="documentos-dados-grid">
            @if (Model.DadosDocumento != null)
            {
                @foreach (var propriedade in Model.DadosDocumento.RootElement.EnumerateObject())
                {
                    var rotulo = propriedade.Name switch
                    {
                        "NomeAluno" => "Nome do aluno",
                        "InstituicaoEnsino" => "Instituição de ensino",
                        "UnidadeConcedente" => "Unidade concedente",
                        "DataInicio" => "Data de início",
                        "DataFim" => "Data de término",
                        "Atividades" => "Atividades previstas",
                        "DataAtividade" => "Data da atividade",
                        "HorarioEntrada" => "Horário de entrada",
                        "HorarioSaida" => "Horário de saída",
                        "AtividadesRealizadas" => "Atividades realizadas",
                        "AtividadesDesenvolvidas" => "Atividades desenvolvidas",
                        "ConsideracoesFinais" => "Considerações finais",
                        _ => propriedade.Name
                    };

                    var valor = propriedade.Value;
                    var texto = "Não informado";

                    if (valor.ValueKind == System.Text.Json.JsonValueKind.String &&
                        !string.IsNullOrWhiteSpace(valor.GetString()))
                    {
                        texto = valor.GetString()!;

                        if ((propriedade.Name == "DataInicio" ||
                             propriedade.Name == "DataFim" ||
                             propriedade.Name == "DataAtividade") &&
                            DateTime.TryParse(texto, out var data))
                        {
                            texto = data.ToString("dd/MM/yyyy");
                        }

                        if ((propriedade.Name == "HorarioEntrada" ||
                             propriedade.Name == "HorarioSaida") &&
                            TimeSpan.TryParse(texto, out var horario))
                        {
                            texto = horario.ToString(@"hh\:mm");
                        }
                    }
                    else if (valor.ValueKind != System.Text.Json.JsonValueKind.Null &&
                             valor.ValueKind != System.Text.Json.JsonValueKind.Undefined)
                    {
                        texto = valor.ToString();
                    }

                    <div class="documentos-dado">
                        <span class="documentos-dado-label">@rotulo</span>
                        <div class="documentos-dado-valor">@texto</div>
                    </div>
                }
            }
        </div>

        <div class="documentos-assinaturas" id="assinaturasDocumento">
            <div><span>Assinatura do aluno</span></div>
            <div><span>Assinatura do responsável</span></div>
        </div>
    </div>
</div>

<style>
    @@page {
        size: A4 portrait;
        margin: 20mm;
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        .documentos-visualizar-page,
        .documentos-visualizar-page *,
        #identificacaoDocumento,
        #identificacaoDocumento *,
        #dadosDocumento,
        #dadosDocumento *,
        #assinaturasDocumento,
        #assinaturasDocumento * {
            visibility: visible !important;
        }

        .documentos-visualizar-page {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 0 !important;
            margin: 0 !important;
        }

        .documentos-header-acoes {
            display: none !important;
        }

        .documentos-visualizacao-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }

        #assinaturasDocumento {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        #dadosDocumento .documentos-dado {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .documentos-dado-valor {
            border: none !important;
            padding-left: 0 !important;
            background: white !important;
        }
    }
</style>
