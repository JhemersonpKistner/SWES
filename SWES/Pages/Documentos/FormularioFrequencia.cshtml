@page
@model SWES.Pages.Documentos.FormularioFrequenciaModel

@{
    ViewData["Title"] = "Formulário de Frequência";
}

<div class="container-fluid py-4">
    <h2>
        <i class="bi bi-calendar-check"></i>
        Formulário de Frequência
    </h2>

    <p class="text-muted">
        Preencha as informações de frequência
        e atividades realizadas durante o estágio.
    </p>

    <form method="post">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    Informações de frequência
                </h5>

                <div class="mb-3">
                    <label asp-for="EstagioId" class="form-label">
                        Estágio / Número de protocolo
                    </label>

                    <select asp-for="EstagioId" class="form-select" required>
                        <option value="">Selecione um estágio...</option>

                        @foreach (var estagio in Model.EstagiosDisponiveis)
                        {
                            <option value="@estagio.Id">
                                @estagio.Protocolo - @estagio.Tipo
                            </option>
                        }
                    </select>

                    <span asp-validation-for="EstagioId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nome do aluno</label>
                    <input asp-for="NomeAluno" class="form-control" />
                    <span asp-validation-for="NomeAluno" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Data da atividade</label>
                    <input asp-for="DataAtividade" type="date" class="form-control" />
                    <span asp-validation-for="DataAtividade" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Horário de entrada</label>
                    <input asp-for="HorarioEntrada" type="time" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Horário de saída</label>
                    <input asp-for="HorarioSaida" type="time" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Atividades realizadas</label>
                    <textarea asp-for="AtividadesRealizadas" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary me-2">
            <i class="bi bi-check-circle"></i>
            Salvar frequência
        </button>
    </form>

    <a href="/Documentos/Index" class="btn btn-outline-secondary">
        Voltar
    </a>
</div>