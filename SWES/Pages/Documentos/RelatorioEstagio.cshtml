@page
@model SWES.Pages.Documentos.RelatorioEstagioModel

@{
    ViewData["Title"] = "Relatório de Estágio";
}

<div class="container-fluid py-4">
    <h2>
        <i class="bi bi-journal-text"></i>
        Relatório de Estágio
    </h2>

    <p class="text-muted">
        Preencha as informações sobre as atividades
        desenvolvidas durante o estágio.
    </p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    Informações do relatório
                </h5>

                <div class="mb-3">
                    <label asp-for="EstagioId" class="form-label">
                        Estágio / Número de protocolo
                    </label>

                    <select asp-for="EstagioId" class="form-select" required>
                        <option value="">Selecione um estágio...</option>

                        @foreach (var estagio in Model.EstagiosDisponiveis)
                        {
                            <option value="@estagio.Id">
                                @estagio.Protocolo - @estagio.Tipo
                            </option>
                        }
                    </select>

                    <span asp-validation-for="EstagioId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NomeAluno" class="form-label">
                        Nome do aluno
                    </label>
                    <input asp-for="NomeAluno" class="form-control" />
                    <span asp-validation-for="NomeAluno" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UnidadeConcedente" class="form-label">
                        Unidade concedente
                    </label>
                    <input asp-for="UnidadeConcedente" class="form-control" />
                    <span asp-validation-for="UnidadeConcedente" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DataInicio" class="form-label">
                            Data de início
                        </label>
                        <input asp-for="DataInicio" type="date" class="form-control" />
                        <span asp-validation-for="DataInicio" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DataFim" class="form-label">
                            Data de término
                        </label>
                        <input asp-for="DataFim" type="date" class="form-control" />
                        <span asp-validation-for="DataFim" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AtividadesDesenvolvidas" class="form-label">
                        Atividades desenvolvidas
                    </label>
                    <textarea asp-for="AtividadesDesenvolvidas" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="AtividadesDesenvolvidas" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConsideracoesFinais" class="form-label">
                        Considerações finais
                    </label>
                    <textarea asp-for="ConsideracoesFinais" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary me-2">
            <i class="bi bi-check-circle"></i>
            Salvar relatório
        </button>
    </form>

    <a href="/Documentos/Index" class="btn btn-outline-secondary">
        Voltar
    </a>
</div>
