@page
@using SWES.ViewModels
@model SWES.Pages.Estagios.CadastroModel

@{
    ViewData["Title"] = Model.Estagio.Id.HasValue
        ? "Editar estágio"
        : "Cadastrar estágio";
}

<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet" />

<div class="estagios-page estagios-cadastro-page">

    <div class="mb-4 estagios-cadastro-header">
        <a asp-page="./Index" class="text-decoration-none estagios-voltar">
            <i class="bi bi-arrow-left"></i> Voltar para estágios
        </a>

        <span class="estagios-eyebrow">GERENCIAMENTO ACADÊMICO</span>
        <h1 class="mt-2">@ViewData["Title"]</h1>

        <p class="text-muted">
            Preencha as informações do estágio supervisionado.
        </p>
    </div>

    <form method="post" enctype="multipart/form-data" class="estagios-formulario">

        <input type="hidden" asp-for="Estagio.Id" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- INFORMAÇÕES GERAIS -->

        <section class="secao-estagio">
            <h5 class="secao-estagio-titulo">
                <i class="bi bi-info-circle"></i>
                Informações gerais
            </h5>

            <div class="row g-3 estagios-form-grid">

                <div class="col-md-4 estagios-campo">
                    <label asp-for="Estagio.Etapa" class="form-label estagios-label">
                        Etapa do estágio
                    </label>

                    <select asp-for="Estagio.Etapa" class="form-select estagios-input">
                        <option value="">Selecione</option>

                        @foreach (var etapa in EstagioCadastroViewModel.EtapasDisponiveis)
                        {
                            <option value="@etapa">@etapa</option>
                        }
                    </select>

                    <span asp-validation-for="Estagio.Etapa" class="text-danger"></span>
                </div>

                <div class="col-md-4 estagios-campo">
                    <label asp-for="Estagio.Tipo" class="form-label estagios-label">
                        Tipo
                    </label>

                    <input asp-for="Estagio.Tipo" class="form-control estagios-input"
                           placeholder="Ex.: Supervisionado" />

                    <span asp-validation-for="Estagio.Tipo" class="text-danger"></span>
                </div>

                <div class="col-md-4 estagios-campo">
                    <label asp-for="Estagio.Situacao" class="form-label estagios-label">
                        Situação
                    </label>

                    <select asp-for="Estagio.Situacao" class="form-select estagios-input">
                        @foreach (var situacao in EstagioCadastroViewModel.SituacoesDisponiveis)
                        {
                            <option value="@situacao">@situacao</option>
                        }
                    </select>

                    <span asp-validation-for="Estagio.Situacao" class="text-danger"></span>
                </div>

                <div class="col-md-4 estagios-campo">
                    <label asp-for="Estagio.DataInicio" class="form-label estagios-label">
                        Data de início
                    </label>

                    <input asp-for="Estagio.DataInicio" type="date" asp-format="{0:yyyy-MM-dd}"
                           class="form-control estagios-input" />

                    <span asp-validation-for="Estagio.DataInicio" class="text-danger"></span>
                </div>

                <div class="col-md-4 estagios-campo">
                    <label asp-for="Estagio.DataFim" class="form-label estagios-label">
                        Data de término
                    </label>

                    <input asp-for="Estagio.DataFim" type="date" asp-format="{0:yyyy-MM-dd}"
                           class="form-control estagios-input" />

                    <span asp-validation-for="Estagio.DataFim" class="text-danger"></span>
                </div>

                <div class="col-md-4 estagios-campo">
                    <label asp-for="Estagio.Horario" class="form-label estagios-label">
                        Horário
                    </label>

                    <input asp-for="Estagio.Horario" class="form-control estagios-input"
                           placeholder="Ex.: Segunda a sexta, das 13h às 17h" />

                    <span asp-validation-for="Estagio.Horario" class="text-danger"></span>
                </div>

                <div class="col-12 estagios-campo">
                    <label asp-for="Estagio.Observacao" class="form-label estagios-label">
                        Observações
                    </label>

                    <textarea asp-for="Estagio.Observacao" class="form-control estagios-input" rows="3"
                              maxlength="500"></textarea>

                    <span asp-validation-for="Estagio.Observacao" class="text-danger"></span>
                </div>

            </div>
        </section>

        <!-- SEGURO -->

        <section class="secao-estagio">
            <h5 class="secao-estagio-titulo">
                <i class="bi bi-shield-check"></i>
                Apólice de seguro
            </h5>

            <div class="row g-3 estagios-form-grid">

                <div class="col-md-6 estagios-campo">
                    <label asp-for="Estagio.ApoliceSeguro" class="form-label estagios-label">
                        Número da apólice
                    </label>

                    <input asp-for="Estagio.ApoliceSeguro" class="form-control estagios-input" />

                    <span asp-validation-for="Estagio.ApoliceSeguro" class="text-danger"></span>
                </div>

                <div class="col-md-6 estagios-campo">
                    <label asp-for="Estagio.Seguradora" class="form-label estagios-label">
                        Seguradora
                    </label>

                    <input asp-for="Estagio.Seguradora" class="form-control estagios-input" />

                    <span asp-validation-for="Estagio.Seguradora" class="text-danger"></span>
                </div>

            </div>
        </section>

        <!-- VÍNCULOS -->
        @{
            var instituicaoSelecionada = Model.Opcoes.InstituicoesEnsino
                .FirstOrDefault(i => i.Id == Model.Estagio.InstituicaoEnsinoId);
                
            var professorSelecionado = Model.Opcoes.Professores
                .FirstOrDefault(p => p.Id == Model.Estagio.ProfessorOrientadorId);

            var supervisorSelecionado = Model.Opcoes.Supervisores
                .FirstOrDefault(s => s.Id == Model.Estagio.SupervisorEstagioId);

            var unidadeSelecionada = Model.Opcoes.UnidadesConcedentes
                .FirstOrDefault(u => u.Id == Model.Estagio.UnidadeConcedenteId);

            var coordenadorSelecionado = Model.Opcoes.Coordenadores
                .FirstOrDefault(c => c.Id == Model.Estagio.CoordenadorId);

            var alunosSelecionados = Model.Opcoes.Alunos
                .Where(a => Model.Estagio.AlunosIds.Contains(a.Id))
                .ToList();
        }

        <section class="secao-estagio">
            <h5 class="secao-estagio-titulo">
                <i class="bi bi-diagram-3"></i>
                Vínculos do estágio
            </h5>

            <div class="row g-3 estagios-form-grid">

                <!-- INSTITUIÇÃO DE ENSINO -->
                <div class="col-md-6 estagios-campo">
                    <label class="form-label estagios-label">Instituição de ensino</label>

                    <input type="hidden" asp-for="Estagio.InstituicaoEnsinoId"
                        id="instituicaoEnsinoId" />

                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-outline-primary estagios-btn-selecao"
                                data-bs-toggle="modal" data-bs-target="#modalInstituicao">
                            <i class="bi bi-search"></i>
                            Selecionar instituição
                        </button>

                        <span id="instituicaoSelecionada" class="estagios-selecao-valor">
                            @(instituicaoSelecionada?.Nome ?? "Nenhuma instituição selecionada")
                        </span>
                    </div>

                    <span asp-validation-for="Estagio.InstituicaoEnsinoId"
                        class="text-danger"></span>
                </div>

                <!-- COORDENADOR -->
                <div class="col-md-6 estagios-campo">
                    <label class="form-label estagios-label">Coordenador (opcional)</label>

                    <input type="hidden" asp-for="Estagio.CoordenadorId"
                        id="coordenadorId" />

                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-outline-primary estagios-btn-selecao"
                                id="abrirModalCoordenador"
                                data-bs-toggle="modal" data-bs-target="#modalCoordenador">
                            <i class="bi bi-search"></i>
                            Selecionar coordenador
                        </button>

                        <span id="coordenadorSelecionado" class="estagios-selecao-valor">
                            @(coordenadorSelecionado?.Nome ?? "Nenhum coordenador selecionado")
                        </span>
                    </div>
                </div>

                <!-- PROFESSOR -->
                <div class="col-md-6 estagios-campo">
                    <label class="form-label estagios-label">Professor orientador</label>

                    <input type="hidden" asp-for="Estagio.ProfessorOrientadorId"
                        id="professorOrientadorId" />

                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-outline-primary estagios-btn-selecao"
                                id="abrirModalProfessor"
                                data-bs-toggle="modal" data-bs-target="#modalProfessor">
                            <i class="bi bi-search"></i>
                            Selecionar professor
                        </button>

                        <span id="professorSelecionado" class="estagios-selecao-valor">
                            @(professorSelecionado?.Nome ?? "Nenhum professor selecionado")
                        </span>
                    </div>

                    <span asp-validation-for="Estagio.ProfessorOrientadorId"
                        class="text-danger"></span>
                </div>

                <!-- UNIDADE CONCEDENTE -->
                <div class="col-md-6 estagios-campo">
                    <label class="form-label estagios-label">Unidade concedente</label>

                    <input type="hidden" asp-for="Estagio.UnidadeConcedenteId"
                        id="unidadeConcedenteId" />

                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-outline-primary estagios-btn-selecao"
                                data-bs-toggle="modal" data-bs-target="#modalUnidade">
                            <i class="bi bi-search"></i>
                            Selecionar unidade
                        </button>

                        <span id="unidadeSelecionada" class="estagios-selecao-valor">
                            @(unidadeSelecionada?.Nome ?? "Nenhuma unidade selecionada")
                        </span>
                    </div>

                    <span asp-validation-for="Estagio.UnidadeConcedenteId"
                        class="text-danger"></span>
                </div>

                <!-- SUPERVISOR -->
                <div class="col-md-6 estagios-campo">
                    <label class="form-label estagios-label">Supervisor de estágio</label>

                    <input type="hidden" asp-for="Estagio.SupervisorEstagioId"
                        id="supervisorEstagioId" />

                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-outline-primary estagios-btn-selecao"
                                id="abrirModalSupervisor"
                                data-bs-toggle="modal" data-bs-target="#modalSupervisor">
                            <i class="bi bi-search"></i>
                            Selecionar supervisor
                        </button>

                        <span id="supervisorSelecionado" class="estagios-selecao-valor">
                            @(supervisorSelecionado?.Nome ?? "Nenhum supervisor selecionado")
                        </span>
                    </div>

                    <span asp-validation-for="Estagio.SupervisorEstagioId"
                        class="text-danger"></span>
                </div>                     
            
                <!-- ALUNOS -->
                <div class="col-12 estagios-campo">
                    <label class="form-label estagios-label">Alunos vinculados</label>

                    <div id="alunosIdsContainer">
                        @foreach (var aluno in alunosSelecionados)
                        {
                            <input type="hidden" name="Estagio.AlunosIds" value="@aluno.Id" />
                        }
                    </div>

                    <button type="button" class="btn btn-outline-primary estagios-btn-selecao"
                            id="abrirModalAlunos"
                            data-bs-toggle="modal" data-bs-target="#modalAlunos">
                        <i class="bi bi-search"></i>
                        Selecionar alunos
                    </button>

                    <div id="alunosSelecionados" class="mt-2">
                        @if (alunosSelecionados.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var aluno in alunosSelecionados)
                                {
                                    <span class="badge bg-primary">@aluno.Nome</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Nenhum aluno selecionado</span>
                        }
                    </div>

                    <span asp-validation-for="Estagio.AlunosIds" class="text-danger"></span>
                    <div class="campo-ajuda mt-1">
                        Você poderá selecionar vários alunos na janela de busca.
                    </div>
                </div>

            </div>
        </section>

        <!-- MODAL DE PROFESSORES -->
        <div class="modal fade" id="modalProfessor" tabindex="-1"
            aria-labelledby="tituloModalProfessor" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalProfessor">
                            <i class="bi bi-person-badge"></i>
                            Buscar professor orientador
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" id="pesquisaProfessor"
                            class="form-control mb-3"
                            placeholder="Digite o nome do professor..." />
                        <div id="listaProfessores" class="list-group"></div>
                        <div id="nenhumProfessorEncontrado"
                            class="text-muted text-center py-3 d-none">
                            Nenhum professor encontrado.
                        </div>
                        <div id="avisoInstituicaoProfessor"
                            class="text-muted text-center py-3 d-none">
                            Selecione primeiro uma instituição de ensino.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL DE UNIDADES CONCEDENTES -->
        <div class="modal fade" id="modalUnidade" tabindex="-1"
            aria-labelledby="tituloModalUnidade" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalUnidade">
                            <i class="bi bi-building"></i>
                            Buscar unidade concedente
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" id="pesquisaUnidade"
                            class="form-control mb-3"
                            placeholder="Digite o nome da unidade..." />

                        <div id="listaUnidades" class="list-group">
                            @foreach (var unidade in Model.Opcoes.UnidadesConcedentes)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action unidade-opcao estagios-modal-opcao"
                                        data-id="@unidade.Id" data-nome="@unidade.Nome">
                                    <i class="bi bi-building me-2"></i>
                                    @unidade.Nome
                                </button>
                            }
                        </div>

                        <div id="nenhumaUnidadeEncontrada"
                            class="text-muted text-center py-3 d-none">
                            Nenhuma unidade encontrada.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL DE SUPERVISORES -->
        <div class="modal fade" id="modalSupervisor" tabindex="-1"
            aria-labelledby="tituloModalSupervisor" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalSupervisor">
                            <i class="bi bi-person-workspace"></i>
                            Buscar supervisor de estágio
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" id="pesquisaSupervisor"
                            class="form-control mb-3"
                            placeholder="Digite o nome do supervisor..." />
                        <div id="listaSupervisores" class="list-group"></div>
                        <div id="nenhumSupervisorEncontrado"
                            class="text-muted text-center py-3 d-none">
                            Nenhum supervisor encontrado.
                        </div>
                        <div id="avisoUnidadeSupervisor"
                            class="text-muted text-center py-3 d-none">
                            Selecione primeiro uma unidade concedente.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL DE COORDENADORES -->
        <div class="modal fade" id="modalCoordenador" tabindex="-1"
            aria-labelledby="tituloModalCoordenador" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalCoordenador">
                            <i class="bi bi-person-lines-fill"></i>
                            Buscar coordenador
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" id="pesquisaCoordenador"
                            class="form-control mb-3"
                            placeholder="Digite o nome do coordenador..." />
                        <div id="listaCoordenadores" class="list-group"></div>
                        <div id="nenhumCoordenadorEncontrado"
                            class="text-muted text-center py-3 d-none">
                            Nenhum coordenador encontrado.
                        </div>
                        <div id="avisoInstituicaoCoordenador"
                            class="text-muted text-center py-3 d-none">
                            Selecione primeiro uma instituição de ensino.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL DE ALUNOS -->
        <div class="modal fade" id="modalAlunos" tabindex="-1"
            aria-labelledby="tituloModalAlunos" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalAlunos">
                            <i class="bi bi-people"></i>
                            Buscar alunos
                        </h5>
                        <button type="button" class="btn-close"
                                data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" id="pesquisaAluno"
                            class="form-control mb-3"
                            placeholder="Digite o nome do aluno..." />

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Marque os alunos desejados:</span>
                            <span id="quantidadeAlunosSelecionados" class="badge bg-primary">
                                @alunosSelecionados.Count selecionado(s)
                            </span>
                        </div>

                        <div id="listaAlunos" class="list-group"></div>

                        <div id="nenhumAlunoEncontrado"
                            class="text-muted text-center py-3 d-none">
                            Nenhum aluno encontrado.
                        </div>

                        <div id="avisoInstituicaoAlunos"
                            class="text-muted text-center py-3 d-none">
                            Selecione primeiro uma instituição de ensino.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary"
                                id="confirmarAlunos" data-bs-dismiss="modal">
                            Confirmar seleção
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <div class="modal fade" id="modalInstituicao" tabindex="-1" aria-labelledby="tituloModalInstituicao"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloModalInstituicao">
                            <i class="bi bi-building"></i>
                            Buscar instituição de ensino
                        </h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>

                    <div class="modal-body">

                        <input type="text" id="pesquisaInstituicao" class="form-control mb-3"
                               placeholder="Digite o nome da instituição..." />

                        <div class="list-group" id="listaInstituicoes">

                            @foreach (var instituicao in Model.Opcoes.InstituicoesEnsino)
                            {
                                <button type="button" class="list-group-item list-group-item-action instituicao-opcao estagios-modal-opcao"
                                        data-id="@instituicao.Id" data-nome="@instituicao.Nome">

                                    <i class="bi bi-building me-2"></i>
                                    @instituicao.Nome
                                </button>
                            }

                        </div>

                        <div id="nenhumaInstituicaoEncontrada" class="text-muted text-center py-3 d-none">
                            Nenhuma instituição encontrada.
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Fechar
                        </button>
                    </div>

                </div>
            </div>
        </div>

        
        <!-- ESPECIFICAÇÕES -->

        <section class="secao-estagio">
            <h5 class="secao-estagio-titulo">
                <i class="bi bi-file-richtext"></i>
                Especificações do estágio
            </h5>

            <p class="campo-ajuda">
                Descreva as atividades, objetivos e demais informações do estágio.
                Escolha a forma de edição desejada.
            </p>

            <!-- Seleção do modo de edição -->
            <div class="mb-3">
                <label class="form-label estagios-label">
                    Forma de edição
                </label>

                <div class="btn-group" role="group" aria-label="Forma de edição das especificações">

                    <input type="radio" class="btn-check" name="modoEspecificacoes" id="modoEditor" value="editor"
                           autocomplete="off" checked />

                    <label class="btn btn-outline-primary estagios-btn-selecao" for="modoEditor">
                        <i class="bi bi-pencil-square"></i>
                        Editor visual
                    </label>

                    <input type="radio" class="btn-check" name="modoEspecificacoes" id="modoHtml" value="html"
                           autocomplete="off" />

                    <label class="btn btn-outline-primary estagios-btn-selecao" for="modoHtml">
                        <i class="bi bi-code-slash"></i>
                        Código HTML
                    </label>
                </div>
            </div>

            <!-- Editor visual -->
            <div id="areaEditorVisual">
                <div id="editorEspecificacoes" class="estagios-editor">
                </div>

                <div class="campo-ajuda mt-2">
                    Utilize a barra de ferramentas para formatar o texto,
                    inserir títulos, listas, links e outros elementos.
                </div>
            </div>

            <!-- Editor de código HTML -->
            <div id="areaEditorHtml" class="d-none">
                <label for="especificacoesHtml" class="form-label estagios-label">
                    Código HTML das especificações
                </label>

                <textarea asp-for="Estagio.EspecificacoesHtml" id="especificacoesHtml"
                          class="form-control font-monospace" rows="14" spellcheck="false" placeholder="<h1>Especificações do estágio</h1>
                <p>Descreva aqui as informações do estágio...</p>"></textarea>

                <div class="campo-ajuda mt-2">
                    Digite ou cole o código HTML que será utilizado
                    para compor as especificações do estágio.
                </div>
            </div>

            <label asp-for="Estagio.ArquivoEspecificacoes" class="form-label mt-3">
                Ou anexar arquivo com as especificações
            </label>

            <input asp-for="Estagio.ArquivoEspecificacoes" type="file"
                   class="form-control estagios-input estagios-arquivo" accept=".pdf,.doc,.docx,.txt" />

            <span asp-validation-for="Estagio.ArquivoEspecificacoes" class="text-danger"></span>

            <div class="campo-ajuda mt-1">
                Formatos permitidos: PDF, DOC, DOCX e TXT. Limite de 10 MB.
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Estagio.EspecificacoesArquivoAtual))
            {
                <div class="mt-2">
                    Arquivo atual:
                    <a href="@Model.Estagio.EspecificacoesArquivoAtual" target="_blank" rel="noopener">
                        @Model.Estagio.NomeArquivoEspecificacoesAtual
                    </a>
                </div>
            }
        </section>


        <!-- EDITAL -->

        <section class="secao-estagio">
            <h5 class="secao-estagio-titulo">
                <i class="bi bi-file-earmark-pdf"></i>
                Edital
            </h5>

            <label asp-for="Estagio.ArquivoEdital" class="form-label estagios-label">
                Anexar edital
            </label>

            <input asp-for="Estagio.ArquivoEdital" type="file" class="form-control estagios-input estagios-arquivo"
                   accept=".pdf,.doc,.docx,.txt" />

            <span asp-validation-for="Estagio.ArquivoEdital" class="text-danger"></span>

            <div class="campo-ajuda mt-1">
                Formatos permitidos: PDF, DOC, DOCX e TXT. Limite de 10 MB.
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Estagio.EditalArquivoAtual))
            {
                <div class="mt-2">
                    Edital atual:
                    <a href="@Model.Estagio.EditalArquivoAtual" target="_blank" rel="noopener">
                        @Model.Estagio.NomeArquivoEditalAtual
                    </a>
                </div>
            }
        </section>

        <!-- BOTÕES -->

        <div class="d-flex justify-content-end gap-2 mb-5 estagios-form-acoes">

            <a asp-page="./Index" class="btn btn-outline-secondary estagios-btn-secundario">
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary estagios-btn-primary">
                <i class="bi bi-check-circle"></i>

                @(Model.Estagio.Id.HasValue
                    ? "Salvar alterações"
                    : "Cadastrar estágio")
            </button>

        </div>

    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>

    <script>
        // Inicializa o editor visual Quill
        const quill = new Quill('#editorEspecificacoes', {
            theme: 'snow',
            placeholder: 'Escreva aqui as especificações do estágio...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'align': [] }],
                    ['link', 'blockquote'],
                    ['clean']
                ]
            }
        });

        // Elementos da tela
        const campoHtml = document.getElementById('especificacoesHtml');

        const areaEditorVisual = document.getElementById('areaEditorVisual');
        const areaEditorHtml = document.getElementById('areaEditorHtml');

        const modoEditor = document.getElementById('modoEditor');
        const modoHtml = document.getElementById('modoHtml');

        // Recupera o conteúdo já salvo no banco
        if (campoHtml.value) {
            quill.clipboard.dangerouslyPasteHTML(campoHtml.value);
        }

        // Alterna para o modo HTML
        modoHtml.addEventListener('change', function () {
            if (this.checked) {

                // Transfere o conteúdo visual para o campo HTML
                campoHtml.value = quill.root.innerHTML;

                areaEditorVisual.classList.add('d-none');
                areaEditorHtml.classList.remove('d-none');
            }
        });

        // Alterna para o editor visual
        modoEditor.addEventListener('change', function () {
            if (this.checked) {

                // Transfere o código HTML para o editor visual
                quill.setText('');

                quill.clipboard.dangerouslyPasteHTML(campoHtml.value);

                areaEditorHtml.classList.add('d-none');
                areaEditorVisual.classList.remove('d-none');
            }
        });

        // Antes de enviar o formulário, garante que o conteúdo
        // do modo selecionado seja enviado ao servidor
        document.querySelector('.estagios-formulario')
            .addEventListener('submit', function () {

                if (modoEditor.checked) {
                    campoHtml.value = quill.root.innerHTML;
                }

            });


        // ==========================================
        // FUNÇÕES AUXILIARES DOS MODAIS
        // ==========================================

        // Obtém o identificador e o nome dos registros retornados pelo servidor.
        function obterId(item) {
            return item.id ?? item.Id;
        }

        function obterNome(item) {
            return item.nome ?? item.Nome;
        }

        // Consulta os registros nos handlers do CadastroModel.
        async function buscarRegistros(handler, parametro, valor) {
            const url = `?handler=${handler}&${parametro}=${encodeURIComponent(valor)}`;

            const resposta = await fetch(url);

            if (!resposta.ok) {
                throw new Error(`Erro ao consultar ${handler}.`);
            }

            return await resposta.json();
        }

        // ==========================================
        // INSTITUIÇÕES DE ENSINO
        // ==========================================

        const pesquisaInstituicao = document.getElementById('pesquisaInstituicao');
        const opcoesInstituicao = document.querySelectorAll('.instituicao-opcao');
        const nenhumaInstituicao = document.getElementById('nenhumaInstituicaoEncontrada');

        pesquisaInstituicao.addEventListener('input', function () {
            const termo = this.value.toLowerCase().trim();
            let quantidadeVisivel = 0;

            opcoesInstituicao.forEach(function (opcao) {
                const nome = opcao.dataset.nome.toLowerCase();
                const corresponde = nome.includes(termo);

                opcao.classList.toggle('d-none', !corresponde);

                if (corresponde) {
                    quantidadeVisivel++;
                }
            });

            nenhumaInstituicao.classList.toggle('d-none', quantidadeVisivel > 0);
        });

        opcoesInstituicao.forEach(function (opcao) {
            opcao.addEventListener('click', function () {
                const instituicaoId = this.dataset.id;
                const instituicaoNome = this.dataset.nome;

                const instituicaoAnterior =
                    document.getElementById('instituicaoEnsinoId').value;

                document.getElementById('instituicaoEnsinoId').value = instituicaoId;
                document.getElementById('instituicaoSelecionada').textContent = instituicaoNome;

                // Só limpa os vínculos se a instituição realmente mudou.
                if (instituicaoAnterior !== instituicaoId) {
                    limparProfessor();
                    limparCoordenador();
                    limparAlunos();
                }

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('modalInstituicao')
                ).hide();
            });
        });

        document.getElementById('modalInstituicao')
            .addEventListener('shown.bs.modal', function () {
                pesquisaInstituicao.value = '';
                pesquisaInstituicao.dispatchEvent(new Event('input'));
                pesquisaInstituicao.focus();
            });

        // ==========================================
        // FUNÇÕES PARA LIMPAR SELEÇÕES
        // ==========================================

        function limparProfessor() {
            document.getElementById('professorOrientadorId').value = '';
            document.getElementById('professorSelecionado').textContent =
                'Nenhum professor selecionado';
        }

        function limparCoordenador() {
            document.getElementById('coordenadorId').value = '';
            document.getElementById('coordenadorSelecionado').textContent =
                'Nenhum coordenador selecionado';
        }

        function limparSupervisor() {
            document.getElementById('supervisorEstagioId').value = '';
            document.getElementById('supervisorSelecionado').textContent =
                'Nenhum supervisor selecionado';
        }

        function limparAlunos() {
            document.getElementById('alunosIdsContainer').innerHTML = '';

            document.getElementById('alunosSelecionados').innerHTML =
                '<span class="text-muted">Nenhum aluno selecionado</span>';

            document.getElementById('quantidadeAlunosSelecionados').textContent =
                '0 selecionado(s)';
        }

        // ==========================================
        // FUNÇÃO PARA CRIAR OPÇÕES NOS MODAIS
        // ==========================================

        function criarOpcaoModal(lista, id, nome, aoSelecionar) {
            const botao = document.createElement('button');

            botao.type = 'button';
            botao.className = 'list-group-item list-group-item-action';

            botao.textContent = nome;

            botao.addEventListener('click', function () {
                aoSelecionar(id, nome);
            });

            lista.appendChild(botao);
        }

        // ==========================================
        // PROFESSORES
        // ==========================================

        let professoresCarregados = [];

        const listaProfessores = document.getElementById('listaProfessores');
        const pesquisaProfessor = document.getElementById('pesquisaProfessor');
        const nenhumProfessor = document.getElementById('nenhumProfessorEncontrado');
        const avisoProfessor = document.getElementById('avisoInstituicaoProfessor');

        function renderizarProfessores() {
            const termo = pesquisaProfessor.value.toLowerCase().trim();

            listaProfessores.innerHTML = '';

            const filtrados = professoresCarregados.filter(function (professor) {
                return obterNome(professor).toLowerCase().includes(termo);
            });

            filtrados.forEach(function (professor) {
                criarOpcaoModal(
                    listaProfessores,
                    obterId(professor),
                    obterNome(professor),
                    function (id, nome) {
                        document.getElementById('professorOrientadorId').value = id;
                        document.getElementById('professorSelecionado').textContent = nome;

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('modalProfessor')
                        ).hide();
                    }
                );
            });

            nenhumProfessor.classList.toggle('d-none', filtrados.length > 0);
        }

        pesquisaProfessor.addEventListener('input', renderizarProfessores);

        document.getElementById('modalProfessor')
            .addEventListener('shown.bs.modal', async function () {
                const instituicaoId =
                    document.getElementById('instituicaoEnsinoId').value;

                pesquisaProfessor.value = '';
                listaProfessores.innerHTML = '';

                if (!instituicaoId) {
                    avisoProfessor.classList.remove('d-none');
                    nenhumProfessor.classList.add('d-none');
                    pesquisaProfessor.disabled = true;
                    return;
                }

                avisoProfessor.classList.add('d-none');
                pesquisaProfessor.disabled = false;

                try {
                    professoresCarregados = await buscarRegistros(
                        'Professores',
                        'instituicaoId',
                        instituicaoId
                    );

                    renderizarProfessores();
                    pesquisaProfessor.focus();
                } catch (erro) {
                    console.error(erro);
                    nenhumProfessor.textContent =
                        'Não foi possível carregar os professores.';
                    nenhumProfessor.classList.remove('d-none');
                }
            });

        // ==========================================
        // UNIDADES CONCEDENTES
        // ==========================================

        const pesquisaUnidade = document.getElementById('pesquisaUnidade');
        const opcoesUnidade = document.querySelectorAll('.unidade-opcao');
        const nenhumaUnidade = document.getElementById('nenhumaUnidadeEncontrada');

        pesquisaUnidade.addEventListener('input', function () {
            const termo = this.value.toLowerCase().trim();
            let quantidadeVisivel = 0;

            opcoesUnidade.forEach(function (opcao) {
                const nome = opcao.dataset.nome.toLowerCase();
                const corresponde = nome.includes(termo);

                opcao.classList.toggle('d-none', !corresponde);

                if (corresponde) {
                    quantidadeVisivel++;
                }
            });

            nenhumaUnidade.classList.toggle('d-none', quantidadeVisivel > 0);
        });

        opcoesUnidade.forEach(function (opcao) {
            opcao.addEventListener('click', function () {
                const unidadeId = this.dataset.id;
                const unidadeNome = this.dataset.nome;

                const unidadeAnterior =
                    document.getElementById('unidadeConcedenteId').value;

                document.getElementById('unidadeConcedenteId').value = unidadeId;
                document.getElementById('unidadeSelecionada').textContent = unidadeNome;

                if (unidadeAnterior !== unidadeId) {
                    limparSupervisor();
                }

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('modalUnidade')
                ).hide();
            });
        });

        document.getElementById('modalUnidade')
            .addEventListener('shown.bs.modal', function () {
                pesquisaUnidade.value = '';
                pesquisaUnidade.dispatchEvent(new Event('input'));
                pesquisaUnidade.focus();
            });

        // ==========================================
        // SUPERVISORES
        // ==========================================

        let supervisoresCarregados = [];

        const listaSupervisores = document.getElementById('listaSupervisores');
        const pesquisaSupervisor = document.getElementById('pesquisaSupervisor');
        const nenhumSupervisor = document.getElementById('nenhumSupervisorEncontrado');
        const avisoSupervisor = document.getElementById('avisoUnidadeSupervisor');

        function renderizarSupervisores() {
            const termo = pesquisaSupervisor.value.toLowerCase().trim();

            listaSupervisores.innerHTML = '';

            const filtrados = supervisoresCarregados.filter(function (supervisor) {
                return obterNome(supervisor).toLowerCase().includes(termo);
            });

            filtrados.forEach(function (supervisor) {
                criarOpcaoModal(
                    listaSupervisores,
                    obterId(supervisor),
                    obterNome(supervisor),
                    function (id, nome) {
                        document.getElementById('supervisorEstagioId').value = id;
                        document.getElementById('supervisorSelecionado').textContent = nome;

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('modalSupervisor')
                        ).hide();
                    }
                );
            });

            nenhumSupervisor.classList.toggle('d-none', filtrados.length > 0);
        }

        pesquisaSupervisor.addEventListener('input', renderizarSupervisores);

        document.getElementById('modalSupervisor')
            .addEventListener('shown.bs.modal', async function () {
                const unidadeId =
                    document.getElementById('unidadeConcedenteId').value;

                pesquisaSupervisor.value = '';
                listaSupervisores.innerHTML = '';

                if (!unidadeId) {
                    avisoSupervisor.classList.remove('d-none');
                    nenhumSupervisor.classList.add('d-none');
                    pesquisaSupervisor.disabled = true;
                    return;
                }

                avisoSupervisor.classList.add('d-none');
                pesquisaSupervisor.disabled = false;

                try {
                    supervisoresCarregados = await buscarRegistros(
                        'Supervisores',
                        'unidadeConcedenteId',
                        unidadeId
                    );

                    renderizarSupervisores();
                    pesquisaSupervisor.focus();
                } catch (erro) {
                    console.error(erro);
                    nenhumSupervisor.textContent =
                        'Não foi possível carregar os supervisores.';
                    nenhumSupervisor.classList.remove('d-none');
                }
            });

        // ==========================================
        // COORDENADORES
        // ==========================================

        let coordenadoresCarregados = [];

        const listaCoordenadores = document.getElementById('listaCoordenadores');
        const pesquisaCoordenador = document.getElementById('pesquisaCoordenador');
        const nenhumCoordenador = document.getElementById('nenhumCoordenadorEncontrado');
        const avisoCoordenador = document.getElementById('avisoInstituicaoCoordenador');

        function renderizarCoordenadores() {
            const termo = pesquisaCoordenador.value.toLowerCase().trim();

            listaCoordenadores.innerHTML = '';

            const filtrados = coordenadoresCarregados.filter(function (coordenador) {
                return obterNome(coordenador).toLowerCase().includes(termo);
            });

            filtrados.forEach(function (coordenador) {
                criarOpcaoModal(
                    listaCoordenadores,
                    obterId(coordenador),
                    obterNome(coordenador),
                    function (id, nome) {
                        document.getElementById('coordenadorId').value = id;
                        document.getElementById('coordenadorSelecionado').textContent = nome;

                        bootstrap.Modal.getOrCreateInstance(
                            document.getElementById('modalCoordenador')
                        ).hide();
                    }
                );
            });

            nenhumCoordenador.classList.toggle('d-none', filtrados.length > 0);
        }

        pesquisaCoordenador.addEventListener('input', renderizarCoordenadores);

        document.getElementById('modalCoordenador')
            .addEventListener('shown.bs.modal', async function () {
                const instituicaoId =
                    document.getElementById('instituicaoEnsinoId').value;

                pesquisaCoordenador.value = '';
                listaCoordenadores.innerHTML = '';

                if (!instituicaoId) {
                    avisoCoordenador.classList.remove('d-none');
                    nenhumCoordenador.classList.add('d-none');
                    pesquisaCoordenador.disabled = true;
                    return;
                }

                avisoCoordenador.classList.add('d-none');
                pesquisaCoordenador.disabled = false;

                try {
                    coordenadoresCarregados = await buscarRegistros(
                        'Coordenadores',
                        'instituicaoId',
                        instituicaoId
                    );

                    renderizarCoordenadores();
                    pesquisaCoordenador.focus();
                } catch (erro) {
                    console.error(erro);
                    nenhumCoordenador.textContent =
                        'Não foi possível carregar os coordenadores.';
                    nenhumCoordenador.classList.remove('d-none');
                }
            });

        // ==========================================
        // ALUNOS
        // ==========================================

        let alunosCarregados = [];
        let alunosEmEdicao = new Set();

        const listaAlunos = document.getElementById('listaAlunos');
        const pesquisaAluno = document.getElementById('pesquisaAluno');
        const nenhumAluno = document.getElementById('nenhumAlunoEncontrado');
        const avisoAlunos = document.getElementById('avisoInstituicaoAlunos');

        function obterAlunosSelecionados() {
            return Array.from(
                document.querySelectorAll(
                    '#alunosIdsContainer input[name="Estagio.AlunosIds"]'
                )
            ).map(function (campo) {
                return campo.value;
            });
        }

        function renderizarAlunos() {
            const termo = pesquisaAluno.value.toLowerCase().trim();

            listaAlunos.innerHTML = '';

            const filtrados = alunosCarregados.filter(function (aluno) {
                return obterNome(aluno).toLowerCase().includes(termo);
            });

            filtrados.forEach(function (aluno) {
                const id = String(obterId(aluno));
                const nome = obterNome(aluno);

                const linha = document.createElement('label');
                linha.className =
                    'list-group-item d-flex align-items-center gap-2';

                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.className = 'form-check-input mt-0';
                checkbox.value = id;
                checkbox.checked = alunosEmEdicao.has(id);

                checkbox.addEventListener('change', function () {
                    if (this.checked) {
                        alunosEmEdicao.add(id);
                    } else {
                        alunosEmEdicao.delete(id);
                    }

                    document.getElementById(
                        'quantidadeAlunosSelecionados'
                    ).textContent = `${alunosEmEdicao.size} selecionado(s)`;
                });

                const texto = document.createElement('span');
                texto.textContent = nome;

                linha.appendChild(checkbox);
                linha.appendChild(texto);

                listaAlunos.appendChild(linha);
            });

            nenhumAluno.classList.toggle('d-none', filtrados.length > 0);
        }

        pesquisaAluno.addEventListener('input', renderizarAlunos);

        document.getElementById('modalAlunos')
            .addEventListener('shown.bs.modal', async function () {
                const instituicaoId =
                    document.getElementById('instituicaoEnsinoId').value;

                pesquisaAluno.value = '';
                listaAlunos.innerHTML = '';

                if (!instituicaoId) {
                    avisoAlunos.classList.remove('d-none');
                    nenhumAluno.classList.add('d-none');
                    pesquisaAluno.disabled = true;
                    return;
                }

                avisoAlunos.classList.add('d-none');
                pesquisaAluno.disabled = false;

                try {
                    alunosCarregados = await buscarRegistros(
                        'Alunos',
                        'instituicaoId',
                        instituicaoId
                    );

                    alunosEmEdicao = new Set(obterAlunosSelecionados());

                    renderizarAlunos();
                    document.getElementById(
                        'quantidadeAlunosSelecionados'
                    ).textContent = `${alunosEmEdicao.size} selecionado(s)`;

                    pesquisaAluno.focus();
                } catch (erro) {
                    console.error(erro);
                    nenhumAluno.textContent =
                        'Não foi possível carregar os alunos.';
                    nenhumAluno.classList.remove('d-none');
                }
            });

        // Confirma a seleção de alunos e atualiza os campos ocultos.
        document.getElementById('confirmarAlunos')
            ?.addEventListener('click', function () {
                const container = document.getElementById('alunosIdsContainer');
                const exibicao = document.getElementById('alunosSelecionados');

                container.innerHTML = '';
                exibicao.innerHTML = '';

                const alunosSelecionados = alunosCarregados.filter(function (aluno) {
                    return alunosEmEdicao.has(String(obterId(aluno)));
                });

                alunosSelecionados.forEach(function (aluno) {
                    const campo = document.createElement('input');

                    campo.type = 'hidden';
                    campo.name = 'Estagio.AlunosIds';
                    campo.value = obterId(aluno);

                    container.appendChild(campo);
                });

                if (alunosSelecionados.length > 0) {
                    const grupo = document.createElement('div');
                    grupo.className = 'd-flex flex-wrap gap-2';

                    alunosSelecionados.forEach(function (aluno) {
                        const etiqueta = document.createElement('span');
                        etiqueta.className = 'badge bg-primary';
                        etiqueta.textContent = obterNome(aluno);

                        grupo.appendChild(etiqueta);
                    });

                    exibicao.appendChild(grupo);
                } else {
                    exibicao.innerHTML =
                        '<span class="text-muted">Nenhum aluno selecionado</span>';
                }

                document.getElementById(
                    'quantidadeAlunosSelecionados'
                ).textContent = `${alunosSelecionados.length} selecionado(s)`;
            });
    </script>
}

}