@page
@model SWES.Pages.Estagios.IndexModel

@{
    ViewData["Title"] = "Estágios";
}

<div class="estagios-page">

    <div class="instituicoes-header estagios-header">
        <div>
            <div class="estagios-titulo"><span class="instituicoes-eyebrow"><i class="bi bi-journal-check"></i> GESTÃO ACADÊMICA</span>
                <h1>Estágios Supervisionados</h1>
                <p class="mb-0">
                    Gerenciamento dos estágios cadastrados no sistema.
                </p>
            </div>
        </div>

        <a asp-page="./Cadastro" class="instituicoes-btn instituicoes-btn-primary estagios-btn-primary">
            <i class="bi bi-plus-circle"></i>
            Novo estágio
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensagem))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @Model.Mensagem
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @Model.Erro
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <form method="get" class="mb-4 estagios-filtros-form">
        <section class="instituicoes-card estagios-filtros-card">
            <div class="instituicoes-card-header">
                <div><h2>Consultar estágios</h2><p>Pesquise por etapa, professor, aluno, instituição ou situação.</p></div>
            </div>
            <div class="estagios-filtros-conteudo">
                <label asp-for="Pesquisa" class="form-label estagios-label">
                    Pesquisar estágios
                </label>

                <div class="estagios-pesquisa-grupo">
                    <div class="instituicoes-input-wrapper estagios-pesquisa-input"><i class="bi bi-search"></i><input asp-for="Pesquisa"
                           placeholder="Pesquise por etapa, professor, aluno, instituição ou situação..." /></div>

                    <button type="submit" class="instituicoes-btn instituicoes-btn-primary">
                        <i class="bi bi-search"></i>
                        Pesquisar
                    </button>

                    <a asp-page="./Index" class="instituicoes-btn instituicoes-btn-secondary">
                        <i class="bi bi-x-circle"></i>
                        Limpar
                    </a>
                </div>

                <small class="campo-ajuda">
                    A pesquisa considera os dados dos estágios cadastrados.
                </small>
            </div>
        </section>
    </form>


    <section class="instituicoes-card estagios-listagem-card">
        <div class="instituicoes-card-header">
            <div><h2>Estágios cadastrados</h2><p>Consulte as vigências, vínculos e situações dos estágios.</p></div>
            <span class="instituicoes-contador">@Model.Estagios.Count registro(s)</span>
        </div>

            @if (Model.Estagios.Any())
            {
                <div class="instituicoes-tabela-wrapper">
                    <table class="instituicoes-tabela estagios-tabela">

                        <thead>
                            <tr>
                                <th>Etapa</th>
                                <th>Vigência</th>
                                <th>Professor orientador</th>
                                <th>Instituição</th>
                                <th>Alunos</th>
                                <th>Situação</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var estagio in Model.Estagios)
                            {
                                <tr>
                                    <td>
                                        <strong>@estagio.Etapa</strong>
                                        <div class="small text-muted">
                                            @estagio.Tipo
                                        </div>
                                    </td>

                                    <td>
                                        @estagio.DataInicio.ToString("dd/MM/yyyy")
                                        até
                                        @estagio.DataFim.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>@estagio.ProfessorOrientador</td>

                                    <td>@estagio.InstituicaoEnsino</td>

                                    <td>
                                        @foreach (var aluno in estagio.Alunos)
                                        {
                                            <div>@aluno</div>
                                        }
                                    </td>

                                    <td>
                                        @if (estagio.Situacao == "Concluído")
                                        {
                                            <span class="badge bg-success">
                                                @estagio.Situacao
                                            </span>
                                        }
                                        else if (estagio.Situacao == "Cancelado")
                                        {
                                            <span class="badge bg-danger">
                                                @estagio.Situacao
                                            </span>
                                        }
                                        else if (estagio.Situacao == "Validado")
                                        {
                                            <span class="badge bg-primary">
                                                @estagio.Situacao
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @estagio.Situacao
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center estagios-acoes-coluna">
                                        <div class="d-flex justify-content-center gap-2 estagios-acoes">

                                            <a asp-page="./Cadastro" asp-route-id="@estagio.Id"
                                               class="btn btn-sm btn-outline-primary estagios-acao editar"
                                               title="Editar estágio">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form method="post" asp-page-handler="Inativar" asp-route-id="@estagio.Id"
                                                  onsubmit="return confirm('Deseja realmente inativar este estágio?');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning estagios-acao inativar"
                                                        title="Inativar estágio">
                                                    <i class="bi bi-ban"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            
            else
            {
                <div class="instituicoes-vazio estagios-vazio">
                    <div class="instituicoes-vazio-icone"><i class="bi bi-folder2-open"></i></div>

                    @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
                    {
                        <h5 class="mt-3">Nenhum resultado encontrado</h5>

                        <p class="text-muted">
                            Não foram encontrados estágios correspondentes à pesquisa
                            "@Model.Pesquisa".
                        </p>

                        <a asp-page="./Index" class="instituicoes-btn instituicoes-btn-secondary">
                            Limpar pesquisa
                        </a>
                    }
                    else
                    {
                        <h5 class="mt-3">Nenhum estágio cadastrado</h5>

                        <p class="text-muted">
                            Cadastre um estágio para começar a utilizar esta funcionalidade.
                        </p>

                        <a asp-page="./Cadastro" class="instituicoes-btn instituicoes-btn-primary">
                            Cadastrar primeiro estágio
                        </a>
                    }
                </div>
            }

    </section>
</div>