@page
@model SWES.Pages.Estagios.IndexModel

@{
    ViewData["Title"] = "Estágios";
}

<div class="container-fluid py-4 estagios-page">

    <div class="d-flex justify-content-between align-items-center mb-4 estagios-header">
        <div>
            <div class="estagios-titulo"><span class="estagios-eyebrow">GERENCIAMENTO ACADÊMICO</span>
                <h2 class="fw-bold">Estágios Supervisionados</h2>
                <p class="text-muted mb-0">
                    Gerenciamento dos estágios cadastrados no sistema.
                </p>
            </div>
        </div>

        <a asp-page="./Cadastro" class="btn btn-primary estagios-btn-primary">
            <i class="bi bi-plus-circle"></i>
            Novo estágio
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensagem))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @Model.Mensagem
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Erro))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @Model.Erro
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <form method="get" class="mb-4">
        <div class="card shadow-sm estagios-card">
            <div class="card-body">
                <label asp-for="Pesquisa" class="form-label fw-semibold">
                    Pesquisar estágios
                </label>

                <div class="input-group">
                    <input asp-for="Pesquisa" class="form-control"
                           placeholder="Pesquise por etapa, professor, aluno, instituição ou situação..." />

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        Pesquisar
                    </button>

                    <a asp-page="./Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i>
                        Limpar
                    </a>
                </div>

                <small class="text-muted">
                    A pesquisa considera os dados dos estágios cadastrados.
                </small>
            </div>
        </div>
    </form>


    <div class="card shadow-sm estagios-card">
        <div class="card-body estagios-card-body">

            @if (Model.Estagios.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle estagios-tabela">

                        <thead class="table-light">
                            <tr>
                                <th>Etapa</th>
                                <th>Vigência</th>
                                <th>Professor orientador</th>
                                <th>Instituição</th>
                                <th>Alunos</th>
                                <th>Situação</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var estagio in Model.Estagios)
                            {
                                <tr>
                                    <td>
                                        <strong>@estagio.Etapa</strong>
                                        <div class="small text-muted">
                                            @estagio.Tipo
                                        </div>
                                    </td>

                                    <td>
                                        @estagio.DataInicio.ToString("dd/MM/yyyy")
                                        até
                                        @estagio.DataFim.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>@estagio.ProfessorOrientador</td>

                                    <td>@estagio.InstituicaoEnsino</td>

                                    <td>
                                        @foreach (var aluno in estagio.Alunos)
                                        {
                                            <div>@aluno</div>
                                        }
                                    </td>

                                    <td>
                                        @if (estagio.Situacao == "Concluído")
                                        {
                                            <span class="badge bg-success">
                                                @estagio.Situacao
                                            </span>
                                        }
                                        else if (estagio.Situacao == "Cancelado")
                                        {
                                            <span class="badge bg-danger">
                                                @estagio.Situacao
                                            </span>
                                        }
                                        else if (estagio.Situacao == "Validado")
                                        {
                                            <span class="badge bg-primary">
                                                @estagio.Situacao
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @estagio.Situacao
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2 estagios-acoes">

                                            <a asp-page="./Cadastro" asp-route-id="@estagio.Id"
                                               class="btn btn-sm btn-outline-primary estagios-acao editar"
                                               title="Editar estágio">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form method="post" asp-page-handler="Inativar" asp-route-id="@estagio.Id"
                                                  onsubmit="return confirm('Deseja realmente inativar este estágio?');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning estagios-acao inativar"
                                                        title="Inativar estágio">
                                                    <i class="bi bi-ban"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            
            else
            {
                <div class="text-center py-5 estagios-vazio">
                    <i class="bi bi-folder2-open fs-1 text-muted"></i>

                    @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
                    {
                        <h5 class="mt-3">Nenhum resultado encontrado</h5>

                        <p class="text-muted">
                            Não foram encontrados estágios correspondentes à pesquisa
                            "@Model.Pesquisa".
                        </p>

                        <a asp-page="./Index" class="btn btn-outline-primary">
                            Limpar pesquisa
                        </a>
                    }
                    else
                    {
                        <h5 class="mt-3">Nenhum estágio cadastrado</h5>

                        <p class="text-muted">
                            Cadastre um estágio para começar a utilizar esta funcionalidade.
                        </p>

                        <a asp-page="./Cadastro" class="btn btn-primary">
                            Cadastrar primeiro estágio
                        </a>
                    }
                </div>
            }

        </div>
    </div>
</div>