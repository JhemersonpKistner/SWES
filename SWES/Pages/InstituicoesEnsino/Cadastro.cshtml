
@page
@model SWES.Pages.InstituicoesEnsino.CadastroModel

<div class="instituicoes-page">

    <div class="instituicoes-header">
        <div>
            <span class="instituicoes-eyebrow">
                <i class="bi bi-building"></i>
                GESTÃO ACADÊMICA
            </span>

            <h1>
                @(Model.Instituicao.Id.HasValue
                    ? "Editar instituição"
                    : "Cadastrar instituição")
            </h1>

            <p>
                @(Model.Instituicao.Id.HasValue
                    ? "Atualize os dados da instituição de ensino."
                    : "Preencha os dados para registrar uma instituição de ensino.")
            </p>
        </div>

        <a asp-page="/InstituicoesEnsino/Index"
           class="instituicoes-btn instituicoes-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar para listagem
        </a>
    </div>

    <div class="instituicoes-form-card cadastro-card">

        <div class="instituicoes-form-cabecalho">
            <div class="instituicoes-form-icone">
                <i class="bi bi-building-add"></i>
            </div>

            <div>
                <h2>Dados da instituição</h2>
                <p>Informe os dados cadastrais solicitados abaixo.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="instituicoes-validacao-resumo"
             role="alert">
        </div>

        <form method="post" asp-page-handler="Salvar">
            <input type="hidden" asp-for="Instituicao.Id" />

            <div class="instituicoes-form-grid">

                <div class="instituicoes-form-campo">
                    <label asp-for="Instituicao.Nome">
                        Nome da instituição
                        <span class="campo-obrigatorio">*</span>
                    </label>

                    <div class="instituicoes-form-input">
                        <i class="bi bi-building"></i>
                        <input asp-for="Instituicao.Nome"
                               maxlength="150"
                               placeholder="Ex.: Centro Universitário"
                               autocomplete="organization"
                               required />
                    </div>

                    <span asp-validation-for="Instituicao.Nome"
                          class="instituicoes-validacao-campo">
                    </span>
                </div>

                <div class="instituicoes-form-campo">
                    <label asp-for="Instituicao.Cnpj">
                        CNPJ
                        <span class="campo-obrigatorio">*</span>
                    </label>

                    <div class="instituicoes-form-input">
                        <i class="bi bi-card-text"></i>
                        <input asp-for="Instituicao.Cnpj"
                               id="cnpj"
                               maxlength="18"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="00.000.000/0000-00"
                               required />
                    </div>

                    <small class="instituicoes-ajuda">
                        Informe os 14 dígitos do CNPJ.
                    </small>

                    <span asp-validation-for="Instituicao.Cnpj"
                          class="instituicoes-validacao-campo">
                    </span>
                </div>

            </div>

            <div class="instituicoes-form-nota">
                <i class="bi bi-info-circle"></i>
                Os campos marcados com asterisco são obrigatórios.
            </div>

            <div class="instituicoes-form-acoes form-acoes">
                <a asp-page="/InstituicoesEnsino/Index"
                   class="instituicoes-btn instituicoes-btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="instituicoes-btn instituicoes-btn-primary">
                    <i class="bi bi-check-lg"></i>
                    @(Model.Instituicao.Id.HasValue
                        ? "Salvar alterações"
                        : "Cadastrar instituição")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const campoCnpj = document.getElementById("cnpj");

        if (campoCnpj) {
            campoCnpj.addEventListener("input", function () {
                let numeros = this.value
                    .replace(/\D/g, "")
                    .slice(0, 14);

                if (numeros.length > 12) {
                    numeros = numeros.replace(
                        /^(\d{2})(\d{3})(\d{3})(\d{4})(\d{0,2}).*/,
                        "$1.$2.$3/$4-$5");
                } else if (numeros.length > 8) {
                    numeros = numeros.replace(
                        /^(\d{2})(\d{3})(\d{3})(\d{0,4}).*/,
                        "$1.$2.$3/$4");
                } else if (numeros.length > 5) {
                    numeros = numeros.replace(
                        /^(\d{2})(\d{3})(\d{0,3}).*/,
                        "$1.$2.$3");
                } else if (numeros.length > 2) {
                    numeros = numeros.replace(
                        /^(\d{2})(\d{0,3}).*/,
                        "$1.$2");
                }

                this.value = numeros;
            });
        }
    </script>
}
