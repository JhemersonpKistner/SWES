@page
@model SWES.Pages.InstituicoesEnsino.CadastroModel

<div class="container mt-4">
    <div class="mb-4">
        <h1>
            @(Model.Instituicao.Id.HasValue
                ? "Editar Instituição de Ensino"
                : "Cadastrar Instituição de Ensino")
        </h1>

        <p>Preencha os dados da instituição.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <form method="post" asp-page-handler="Salvar">
                <input type="hidden" asp-for="Instituicao.Id" />

                <div class="mb-3">
                    <label asp-for="Instituicao.Nome"
                           class="form-label">
                        Nome da instituição
                    </label>

                    <input asp-for="Instituicao.Nome"
                           class="form-control"
                           maxlength="150"
                           placeholder="Digite o nome da instituição" />

                    <span asp-validation-for="Instituicao.Nome"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Instituicao.Cnpj"
                           class="form-label">
                        CNPJ
                    </label>

                    <input asp-for="Instituicao.Cnpj"
                           id="cnpj"
                           class="form-control"
                           maxlength="18"
                           inputmode="numeric"
                           placeholder="00.000.000/0000-00" />

                    <span asp-validation-for="Instituicao.Cnpj"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <a asp-page="/InstituicoesEnsino/Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        @(Model.Instituicao.Id.HasValue
                            ? "Salvar alterações"
                            : "Cadastrar")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const campoCnpj = document.getElementById("cnpj");

        campoCnpj.addEventListener("input", function () {
            let numeros = this.value.replace(/\D/g, "").slice(0, 14);

            if (numeros.length > 12) {
                numeros = numeros.replace(
                    /^(\d{2})(\d{3})(\d{3})(\d{4})(\d{0,2}).*/,
                    "$1.$2.$3/$4-$5");
            } else if (numeros.length > 8) {
                numeros = numeros.replace(
                    /^(\d{2})(\d{3})(\d{3})(\d{0,4}).*/,
                    "$1.$2.$3/$4");
            } else if (numeros.length > 5) {
                numeros = numeros.replace(
                    /^(\d{2})(\d{3})(\d{0,3}).*/,
                    "$1.$2.$3");
            } else if (numeros.length > 2) {
                numeros = numeros.replace(
                    /^(\d{2})(\d{0,3}).*/,
                    "$1.$2");
            }

            this.value = numeros;
        });
    </script>
}
