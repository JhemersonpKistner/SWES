
@page
@model SWES.Pages.InstituicoesEnsino.IndexModel

<div class="instituicoes-page">

    <div class="instituicoes-header">
        <div>
            <span class="instituicoes-eyebrow">
                <i class="bi bi-building"></i>
                GESTÃO ACADÊMICA
            </span>
            <h1>Instituições de Ensino</h1>
            <p>Gerencie as instituições vinculadas ao sistema de estágios.</p>
        </div>

        <a asp-page="/InstituicoesEnsino/Cadastro"
           class="instituicoes-btn instituicoes-btn-primary">
            <i class="bi bi-plus-lg"></i>
            Cadastrar instituição
        </a>
    </div>

    <div class="instituicoes-resumo">
        <div class="instituicoes-resumo-card">
            <div class="instituicoes-resumo-icone azul">
                <i class="bi bi-buildings"></i>
            </div>
            <div>
                <span>Total de instituições</span>
                <strong>@Model.Instituicoes.Count</strong>
            </div>
        </div>

        <div class="instituicoes-resumo-card">
            <div class="instituicoes-resumo-icone verde">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <span>Instituições ativas</span>
                <strong>@Model.Instituicoes.Count(i => i.Ativo)</strong>
            </div>
        </div>

        <div class="instituicoes-resumo-card">
            <div class="instituicoes-resumo-icone cinza">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <span>Instituições inativas</span>
                <strong>@Model.Instituicoes.Count(i => !i.Ativo)</strong>
            </div>
        </div>
    </div>

    <section class="instituicoes-card">
        <div class="instituicoes-card-header">
            <div>
                <h2>Instituições cadastradas</h2>
                <p>Consulte e gerencie os registros existentes.</p>
            </div>

            <span class="instituicoes-contador">
                @Model.Instituicoes.Count registro(s)
            </span>
        </div>

        <form method="get" class="instituicoes-filtros">
            <div class="instituicoes-pesquisa">
                <label for="Pesquisa">Pesquisar instituição</label>

                <div class="instituicoes-input-wrapper campo-pesquisa">
                    <i class="bi bi-search"></i>
                    <input type="text"
                           id="Pesquisa"
                           name="Pesquisa"
                           value="@Model.Pesquisa"
                           placeholder="Digite o nome ou CNPJ..." />
                </div>
            </div>

            <button type="submit"
                    class="instituicoes-btn instituicoes-btn-primary">
                <i class="bi bi-search"></i>
                Pesquisar
            </button>

            <a asp-page="/InstituicoesEnsino/Index"
               class="instituicoes-btn instituicoes-btn-secondary">
                <i class="bi bi-arrow-counterclockwise"></i>
                Limpar
            </a>
        </form>

        @if (Model.Instituicoes.Count == 0)
        {
            <div class="instituicoes-vazio">
                <div class="instituicoes-vazio-icone">
                    <i class="bi bi-building"></i>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
                {
                    <h3>Nenhum resultado encontrado</h3>
                    <p>
                        Não encontramos instituições correspondentes à sua pesquisa.
                        Tente outro nome ou CNPJ.
                    </p>

                    <a asp-page="/InstituicoesEnsino/Index"
                       class="instituicoes-btn instituicoes-btn-secondary">
                        Limpar pesquisa
                    </a>
                }
                else
                {
                    <h3>Nenhuma instituição cadastrada</h3>
                    <p>Cadastre a primeira instituição de ensino para começar.</p>

                    <a asp-page="/InstituicoesEnsino/Cadastro"
                       class="instituicoes-btn instituicoes-btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        Cadastrar instituição
                    </a>
                }
            </div>
        }
        else
        {
            <div class="instituicoes-tabela-wrapper">
                <table class="instituicoes-tabela">
                    <thead>
                        <tr>
                            <th>Instituição</th>
                            <th>CNPJ</th>
                            <th>Data de cadastro</th>
                            <th>Situação</th>
                            <th class="instituicoes-coluna-acoes">Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var instituicao in Model.Instituicoes)
                        {
                            <tr>
                                <td>
                                    <div class="instituicoes-identificacao">
                                        <div class="instituicoes-avatar">
                                            <i class="bi bi-building"></i>
                                        </div>

                                        <div class="instituicoes-nome">
                                            <strong>@instituicao.RazaoSocial</strong>
                                            <span>Instituição de Ensino</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="instituicoes-cnpj">
                                        @instituicao.Cnpj
                                    </span>
                                </td>

                                <td>
                                    @instituicao.Cadastro.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (instituicao.Ativo)
                                    {
                                        <span class="registro-status ativo instituicoes-status ativa">
                                            <span></span> Ativa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="registro-status inativo instituicoes-status inativa">
                                            <span></span> Inativa
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="registro-acoes instituicoes-acoes">
                                        <a asp-page="/InstituicoesEnsino/Cadastro"
                                           asp-route-id="@instituicao.Id"
                                           class="registro-acao editar instituicoes-acao"
                                           title="Editar instituição"
                                           aria-label="Editar @instituicao.RazaoSocial">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (instituicao.Ativo)
                                        {
                                            <form method="post"
                                                  asp-page-handler="Inativar"
                                                  onsubmit="return abrirConfirmacaoRegistro(this, 'inativar', 'instituição');">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@instituicao.Id" />

                                                <button type="submit"
                                                        class="registro-acao inativar instituicoes-acao"
                                                        title="Inativar instituição"
                                                        aria-label="Inativar @instituicao.RazaoSocial">
                                                    <i class="bi bi-pause-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post"
                                                  asp-page-handler="Ativar"
                                                  onsubmit="return abrirConfirmacaoRegistro(this, 'reativar', 'instituição');">
                                                <input type="hidden"
                                                       name="id"
                                                       value="@instituicao.Id" />

                                                <button type="submit"
                                                        class="registro-acao reativar instituicoes-acao"
                                                        title="Reativar instituição"
                                                        aria-label="Reativar @instituicao.RazaoSocial">
                                                    <i class="bi bi-arrow-clockwise"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>



<!-- Modal de confirmação para ativação/inativação -->
<div class="swes-modal-overlay" id="modalConfirmacaoRegistro" aria-hidden="true">
    <section class="swes-modal" role="dialog" aria-modal="true" aria-labelledby="tituloConfirmacaoRegistro">
        <div class="swes-modal-icone" id="iconeConfirmacaoRegistro"><i class="bi bi-exclamation-triangle"></i></div>
        <h2 id="tituloConfirmacaoRegistro">Confirmar ação</h2>
        <p id="mensagemConfirmacaoRegistro">Deseja realmente continuar?</p>
        <div class="swes-modal-acoes">
            <button type="button" class="swes-modal-cancelar" onclick="fecharConfirmacaoRegistro()">Cancelar</button>
            <button type="button" class="swes-modal-confirmar" id="btnConfirmarRegistro" onclick="confirmarAcaoRegistro()">Confirmar</button>
        </div>
    </section>
</div>
<script>
    let formularioRegistroPendente = null;
    function abrirConfirmacaoRegistro(formulario, acao, tipo) {
        formularioRegistroPendente = formulario;
        const reativar = acao === 'reativar';
        document.getElementById('tituloConfirmacaoRegistro').textContent = reativar ? 'Reativar registro' : 'Inativar registro';
        document.getElementById('mensagemConfirmacaoRegistro').textContent = `Deseja realmente ${reativar ? 'reativar' : 'inativar'} esta ${tipo}?`;
        document.getElementById('btnConfirmarRegistro').textContent = reativar ? 'Reativar' : 'Inativar';
        document.getElementById('btnConfirmarRegistro').classList.toggle('reativar', reativar);
        document.getElementById('iconeConfirmacaoRegistro').innerHTML = reativar ? '<i class="bi bi-arrow-clockwise"></i>' : '<i class="bi bi-exclamation-triangle"></i>';
        const modal = document.getElementById('modalConfirmacaoRegistro');
        modal.classList.add('aberto');
        modal.setAttribute('aria-hidden', 'false');
        document.getElementById('btnConfirmarRegistro').focus();
        return false;
    }
    function fecharConfirmacaoRegistro() {
        const modal = document.getElementById('modalConfirmacaoRegistro');
        modal.classList.remove('aberto');
        modal.setAttribute('aria-hidden', 'true');
        formularioRegistroPendente = null;
    }
    function confirmarAcaoRegistro() {
        if (formularioRegistroPendente) formularioRegistroPendente.submit();
    }
    document.getElementById('modalConfirmacaoRegistro')?.addEventListener('click', function (event) {
        if (event.target === this) fecharConfirmacaoRegistro();
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') fecharConfirmacaoRegistro();
    });
</script>

    <p class="instituicoes-rodape">
        <i class="bi bi-info-circle"></i>
        Instituições inativas permanecem registradas e podem ser reativadas.
    </p>
</div>
